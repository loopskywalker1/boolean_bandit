log_dir <- paste(dirname(res_dir), "logs", sep='/')
dir.create(log_dir, recursive = TRUE, showWarnings = FALSE)

# Create a log file with timestamp
log_timestamp <- format(Sys.time(), "%Y%m%d_%H%M%S")
log_file <- file.path(log_dir, paste0("experiment_log_", log_timestamp, ".txt"))

# Function to write to log file and console
log_message <- function(msg) {
  timestamp <- format(Sys.time(), "%Y-%m-%d %H:%M:%S")
  full_msg <- paste0("[", timestamp, "] ", msg)
  
  # Print to console
  cat(full_msg, "\n")
  
  # Append to log file
  cat(full_msg, "\n", file=log_file, append=TRUE)
}

