def experiment(n_trials, prog_model, y_noise, dgp_string, rng=None):
    """Run one experiment for a given parameter set with GPU acceleration."""
    if rng is None:
        rng = np.random.RandomState()
    
    # Initialize GPU data generator
    data_gen = GPUDataGenerator(use_gpu=GPU_AVAILABLE)
    
    # Generate a new dataset with n_trials samples
    trial_data = data_gen.dgp(n=n_trials, y_noise=y_noise, dgp_string=dgp_string, rng=rng)
    
    # Extract features for prediction
    X_trial = trial_data.filter(like='W')
    y_true = trial_data['Y']
    
    # Predict with prognostic model
    best_learner_name, fitted_model, _ = prog_model
    
    try:
        if GPU_AVAILABLE and '_gpu' in best_learner_name:
            try:
                X_trial_gpu = cudf.from_pandas(X_trial)
                y_pred = fitted_model.predict(X_trial_gpu)
                if hasattr(y_pred, 'values'):
                    y_pred = y_pred.values
                y_pred = cp.asnumpy(y_pred) if isinstance(y_pred, cp.ndarray) else y_pred
            except:
                y_pred = fitted_model.predict(X_trial)
        else:
            y_pred = fitted_model.predict(X_trial)
    except Exception as e:
        logger.error(f"Prediction failed: {e}")
        y_pred = np.zeros(len(X_trial))
    
    # Calculate performance metrics
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    bias = np.mean(y_pred - y_true)
    var_pred = np.var(y_pred)
    
    # Calculate true and estimated treatment effects
    true_ate = trial_data['Y1'].mean() - trial_data['Y0'].mean()
    
    # Simple difference in means estimator
    treated_mean = trial_data.loc[trial_data['A'] == 1, 'Y'].mean()
    control_mean = trial_data.loc[trial_data['A'] == 0, 'Y'].mean()
    naive_ate = treated_mean - control_mean
    
    return {
        'n_trials': n_trials,
        'rmse': rmse,
        'bias': bias,
        'var_pred': var_pred,
        'true_ate': true_ate,
        'naive_ate': naive_ate
    }

# =============================================================================
# PARALLEL EXPERIMENT RUNNER
# =============================================================================

def run_experiment(run_index):
    """Run a full Monte Carlo repetition across parameter grid."""
    worker_id = os.getpid()
    logger.info(f"Worker {worker_id} starting run {run_index}")
    
    # Create worker-specific RNG with unique seed derived from experimental_seed
    run_rng = np.random.RandomState(EXPERIMENT_SEED + run_index)
    
    try:
        results = []
        for n_trials in PARAM_GRID['n_trials']:
            # Call experiment with this parameter setting
            result = experiment(
                n_trials=n_trials,
                prog_model=prog_model,  # Using the global prog_model
                y_noise=Y_NOISE,
                dgp_string=DGP_STRING,
                rng=run_rng
            )
            
            # Add run index and seed for traceability
            result['run'] = run_index
            result['seed'] = EXPERIMENT_SEED
            
            results.append(result)
        
        # Combine all parameter results into a DataFrame
        result_df = pd.DataFrame(results)
        
        # Create output filename like in R
        output_filename = f"experiment_result_run_{run_index}.parquet"
        output_path = EXP_DIR / output_filename
        
        # Write to parquet file
        table = pa.Table.from_pandas(result_df)
        pq.write_table(table, output_path)
        
        logger.info(f"Worker {worker_id} completed run {run_index}")
        return output_filename
        
    except Exception as e:
        logger.error(f"Worker {worker_id} error in run {run_index}: {str(e)}", exc_info=True)
        return None

# =============================================================================
# ENHANCED MAIN FUNCTION
# =============================================================================

def main():
    """Main function with GPU optimization and parallel processing."""
    global prog_model, sig3, best_learner_name, kappa3  # Make these global for multiprocessing
    
    logger.info(f"Starting simulation with {N_RUNS} runs on {N_WORKERS} workers")
    logger.info(f"DGP: {DGP_STRING}, Noise: {Y_NOISE}, CV Folds: {CV_FOLDS}")
    
    # Setup GPU
    gpu_enabled = setup_gpu()
    logger.info(f"GPU acceleration: {'Enabled' if gpu_enabled else 'Disabled'}")
    
    # Generate historical data
    logger.info(f"Generating historical data (n={N_HIST})...")
    data_gen = GPUDataGenerator(use_gpu=gpu_enabled)
    hist_train, hist_test = get_hist_dat(
        n_hist=N_HIST,
        y_noise=Y_NOISE,
        dgp_string=DGP_STRING,
        rng=MAIN_RNG
    )
    
    # Fit prognostic model on historical data
    logger.info("Fitting prognostic model...")
    model_selector = GPUModelSelector(use_gpu=gpu_enabled)
    best_learner_name, prog_model_fitted, cv_rmse = model_selector.fit_prog(
        train_dat=hist_train,
        v=CV_FOLDS,
        rng=MAIN_RNG
    )
    prog_model = (best_learner_name, prog_model_fitted, cv_rmse)
    
    # Calculate kappa on test set
    kappa3 = calc_kappa(prog_model, hist_test)
    logger.info(f"Prognostic model performance (kappa3): {kappa3:.4f}")
    
    # Calculate sig3 (SD of outcome)
    sig3 = np.std(
        np.concatenate([hist_train['Y'].values, hist_test['Y'].values]),
        ddof=1  # Use n-1 denominator like R's sd()
    )
    logger.info(f"Outcome standard deviation (sig3): {sig3:.4f}")
    
    # Run experiments in parallel
    logger.info(f"Running {N_RUNS} Monte Carlo repetitions...")
    start_time = time.time()
    
    with ProcessPoolExecutor(max_workers=N_WORKERS) as executor:
        futures = [executor.submit(run_experiment, i) for i in range(1, N_RUNS + 1)]
        
        # Track progress
        completed = 0
        failed = 0
        
        for future in tqdm(as_completed(futures), total=N_RUNS, desc="MC Runs"):
            try:
                result = future.result()
                if result:
                    completed += 1
                else:
                    failed += 1
            except Exception as e:
                logger.error(f"Error in future: {str(e)}")
                failed += 1
    
    duration = time.time() - start_time
    logger.info(f"Completed {completed} runs, failed {failed} runs in {duration:.1f} seconds")
    
    # Create summary file like in R
    logger.info("Creating metadata file...")
    summary_df = pd.DataFrame({
        'best_learner_name': [best_learner_name],
        'kappa3': [kappa3],
        'sig3': [sig3],
        'dgp_string': [DGP_STRING],
        'n_hist': [N_HIST],
        'y_noise': [Y_NOISE],
        'cv_folds': [CV_FOLDS],
        'timestamp': [run_timestamp],
        'completed_runs': [completed]
    })
    
    # Write summary file
    summary_path = BASE_DIR / f"run_metadata_{DGP_STRING}.parquet"
    summary_table = pa.Table.from_pandas(summary_df)
    pq.write_table(summary_table, summary_path)
    
    logger.info(f"Metadata saved to {summary_path}")
    logger.info(f"Finished simulation run {run_timestamp}")

