def run_experiment(run_index):
    """Run a single experiment"""
    worker_id = os.getpid()
    logging.info(f"Worker {worker_id} starting run {run_index}")
    
    # Generate data
    hist_data = generate_data(n_hist=1000, y_noise=6, dgp_string="dgp3")
    
    # Train-test split
    hist_train, hist_test = train_test_split(hist_data, test_size=0.3, random_state=129483)
    
    # Fit prognostic model
    prog = fit_prog(hist_train, hist_test)
    logging.info(f"Run {run_index}: Fitted prognostic model")
    
    # Calculate kappa
    kappa = calc_kappa(prog, hist_data, hist_test)
    logging.info(f"Run {run_index}: Calculated kappa = {kappa}")
    
    # Prepare results
    result = pd.DataFrame({
        'run_index': [run_index],
        'kappa': [kappa],
        'best_learner_name': ['gbt'],  # Placeholder
        'timestamp': [time.time()]
    })
    
    # Save results
    res_dir = ensure_dir_exists(os.path.join('results', 'dpg3_mini', 'base_run', 'experiments'))
    timestamp = time.strftime("%H%M%S")
    output_filename = f"experiment_result_run_{run_index}_worker{worker_id}_{timestamp}.parquet"
    output_path = os.path.join(res_dir, output_filename)
    
    try:
        # Convert to pyarrow table and write
        table = pa.Table.from_pandas(result)
        pq.write_table(table, output_path)
        logging.info(f"Worker {worker_id} successfully wrote file for run {run_index} to {output_path}")
        return run_index
    except Exception as e:
        logging.error(f"Worker {worker_id} failed to write file for run {run_index}: {str(e)}")
        return None

def main():
    """Main function to run experiments in parallel"""
    n_runs = 8
    logging.info(f"Starting {n_runs} experiments in parallel")
    
    # Use all available cores for parallelism
    n_workers = mp.cpu_count()
    logging.info(f"Using {n_workers} worker processes")
    
    # Create result directory
    res_dir = ensure_dir_exists(os.path.join('results', 'dpg3_mini', 'base_run', 'experiments'))
    
    # Run experiments in parallel using ProcessPoolExecutor
    with ProcessPoolExecutor(max_workers=n_workers) as executor:
        results = list(executor.map(run_experiment, range(1, n_runs + 1)))
    
    # Check results
    completed = [r for r in results if r is not None]
    logging.info(f"Completed {len(completed)} out of {n_runs} experiments")
    
    # List created files
    files = os.listdir(res_dir)
    parquet_files = [f for f in files if f.startswith('experiment_result_run_') and f.endswith('.parquet')]
    logging.info(f"Created {len(parquet_files)} parquet files")
    for file in parquet_files[:5]:  # Show the first 5 files
        logging.info(f"  - {file}")
    
    if len(parquet_files) < n_runs:
        logging.warning(f"Expected {n_runs} files but only found {len(parquet_files)}")

if __name__ == "__main__":
    # Initialize multiprocessing with spawn method for better compatibility
    mp.set_start_method('spawn', force=True)
    main()
