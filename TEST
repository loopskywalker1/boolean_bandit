---
- name: Simple security tools status check
  hosts: all
  become: yes

  tasks:
    - name: Check BigFix
      ansible.builtin.shell: systemctl is-active *etaclient* 2>/dev/null && echo "INSTALLED - RUNNING" || (systemctl list-unit-files | grep -q etaclient && echo "INSTALLED - NOT RUNNING" || echo "NOT INSTALLED")
      register: bigfix_status
      changed_when: false
      failed_when: false

    - name: Check CrowdStrike
      ansible.builtin.shell: systemctl is-active *falcon-sensor* 2>/dev/null && echo "INSTALLED - RUNNING" || (systemctl list-unit-files | grep -q falcon-sensor && echo "INSTALLED - NOT RUNNING" || echo "NOT INSTALLED")
      register: crowdstrike_status
      changed_when: false
      failed_when: false

    - name: Check Qualys
      ansible.builtin.shell: systemctl is-active *qualys-cloud-agent* 2>/dev/null && echo "INSTALLED - RUNNING" || (systemctl list-unit-files | grep -q qualys-cloud-agent && echo "INSTALLED - NOT RUNNING" || echo "NOT INSTALLED")
      register: qualys_status
      changed_when: false
      failed_when: false

    - name: Check Splunk
      ansible.builtin.shell: systemctl is-active *splunk* 2>/dev/null && echo "INSTALLED - RUNNING" || (systemctl list-unit-files | grep -q splunk && echo "INSTALLED - NOT RUNNING" || echo "NOT INSTALLED")
      register: splunk_status
      changed_when: false
      failed_when: false

    - name: Check Tanium
      ansible.builtin.shell: systemctl is-active *tanium* 2>/dev/null && echo "INSTALLED - RUNNING" || (systemctl list-unit-files | grep -q tanium && echo "INSTALLED - NOT RUNNING" || echo "NOT INSTALLED")
      register: tanium_status
      changed_when: false
      failed_when: false

    - name: Display results
      ansible.builtin.debug:
        msg: |
          BigFix: {{ bigfix_status.stdout }}
          CrowdStrike: {{ crowdstrike_status.stdout }}
          Qualys: {{ qualys_status.stdout }}
          Splunk: {{ splunk_status.stdout }}
          Tanium: {{ tanium_status.stdout }}
