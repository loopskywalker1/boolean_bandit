def main():
    """Main function to run the complete experiment pipeline"""
    print("=== Python ML Experiment Pipeline ===")
    print("Translated from R code")
    
    start_time = time.time()
    
    # Initialize parallel runner
    runner = ParallelRunner(n_workers=4)
    
    # Run experiments
    results = runner.run_parallel_experiments(
        n_runs=50,  # Reduced for testing - increase to 200 for full run
        n_trials_list=[100, 200, 300, 400, 500],
        dgp_string="constant",
        y_noise=6
    )
    
    # Print summary statistics
    print("\n=== Summary Statistics ===")
    summary = results.groupby(['method', 'n_trial'])['effect'].agg(['mean', 'std', 'count'])
    print(summary)
    
    elapsed_time = time.time() - start_time
    print(f"\nTotal execution time: {elapsed_time:.2f} seconds")

if __name__ == "__main__":
    main()
