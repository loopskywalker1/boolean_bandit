# Modify run_experiment function to use logging
run_experiment <- function(run_index) {
  worker_id <- Sys.getpid()
  log_message(paste0("Worker ", worker_id, " starting run ", run_index))
  
  # Your existing code
  result <- params %>% pmap_df(experiment,
    hist_lrnr = prog3,
    y_noise = 6,
    dgp_string = "dgp3",
    V = 20)
  
  result$seed <- experimental_seed
  
  # Add uniqueness to filename
  timestamp <- format(Sys.time(), "%H%M%S")
  output_filename <- paste0("experiment_result_run_", run_index, "_worker", worker_id, "_", timestamp, ".parquet")
  full_path <- file.path(res_dir, output_filename)
  
  # Log before writing
  log_message(paste0("Worker ", worker_id, " writing file for run ", run_index, " to: ", full_path))
  
  # Ensure directory exists
  dir.create(res_dir, recursive = TRUE, showWarnings = FALSE)
  
  # Write with error handling
  tryCatch({
    write_parquet(result, full_path)
    log_message(paste0("Worker ", worker_id, " successfully wrote file for run ", run_index))
  }, error = function(e) {
    log_message(paste0("ERROR: Worker ", worker_id, " failed to write file for run ", run_index, ": ", e$message))
  })
  
  return(run_index)
}

