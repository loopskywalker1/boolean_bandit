---
# Advanced Ansible playbook for NVIDIA driver installation on RHEL 8.10
# Features: automatic reboot, backup, rollback, and comprehensive error handling

- name: Advanced NVIDIA Driver Installation on RHEL 8.10
  hosts: all
  become: yes
  vars:
    # Configuration variables
    nvidia_driver_branch: "latest"
    kernel_module_type: "open"  # 'open' or 'proprietary'
    enable_auto_reboot: true
    backup_existing_driver: true
    cuda_repo_url: "https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/cuda-rhel8.repo"
    epel_repo_url: "https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm"
    
    # Paths
    backup_dir: "/var/backup/nvidia-driver"
    log_file: "/var/log/nvidia-driver-install.log"
    
  tasks:
    # Initialize logging
    - name: Create log directory
      file:
        path: "{{ log_file | dirname }}"
        state: directory
        mode: '0755'

    - name: Start installation log
      lineinfile:
        path: "{{ log_file }}"
        line: "=== NVIDIA Driver Installation Started at {{ ansible_date_time.iso8601 }} ==="
        create: yes
        mode: '0644'

    # System validation
    - name: Validate system requirements
      block:
        - name: Check OS version
          assert:
            that:
              - ansible_distribution == "RedHat"
              - ansible_distribution_major_version == "8"
            msg: "This playbook requires Red Hat Enterprise Linux 8"

        - name: Check for NVIDIA GPU
          shell: lspci | grep -i nvidia
          register: gpu_info
          changed_when: false

        - name: Log GPU information
          lineinfile:
            path: "{{ log_file }}"
            line: "Detected GPU: {{ gpu_info.stdout }}"

        - name: Check current kernel version
          command: uname -r
          register: kernel_version
          changed_when: false

        - name: Log kernel version
          lineinfile:
            path: "{{ log_file }}"
            line: "Current kernel: {{ kernel_version.stdout }}"

    # Backup existing installation
    - name: Backup existing NVIDIA driver
      block:
        - name: Check if NVIDIA driver is installed
          command: which nvidia-smi
          register: nvidia_exists
          failed_when: false
          changed_when: false

        - name: Create backup directory
          file:
            path: "{{ backup_dir }}"
            state: directory
            mode: '0755'
          when: nvidia_exists.rc == 0

        - name: Get current driver version
          shell: nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1
          register: old_driver_version
          when: nvidia_exists.rc == 0
          failed_when: false

        - name: Save driver information
          copy:
            content: |
              Driver Version: {{ old_driver_version.stdout | default('Unknown') }}
              Backup Date: {{ ansible_date_time.iso8601 }}
              Kernel Version: {{ ansible_kernel }}
            dest: "{{ backup_dir }}/driver_info.txt"
          when: nvidia_exists.rc == 0

        - name: List installed NVIDIA packages
          shell: rpm -qa | grep -i nvidia > "{{ backup_dir }}/nvidia_packages.txt"
          when: nvidia_exists.rc == 0
          failed_when: false

      when: backup_existing_driver

    # Disable nouveau driver
    - name: Disable nouveau driver
      block:
        - name: Create nouveau blacklist file
          copy:
            content: |
              # Disable nouveau driver for NVIDIA installation
              blacklist nouveau
              options nouveau modeset=0
            dest: /etc/modprobe.d/blacklist-nouveau.conf
            mode: '0644'

        - name: Update GRUB configuration
          lineinfile:
            path: /etc/default/grub
            regexp: '^GRUB_CMDLINE_LINUX='
            backrefs: yes
            line: '\g<0> rd.driver.blacklist=nouveau'
          register: grub_updated

        - name: Rebuild GRUB configuration
          command: grub2-mkconfig -o /boot/grub2/grub.cfg
          when: grub_updated.changed

        - name: Rebuild initramfs
          command: dracut --force
          when: grub_updated.changed

    # Repository configuration
    - name: Configure repositories
      block:
        - name: Enable RHEL repositories
          rhsm_repository:
            name:
              - rhel-8-for-x86_64-appstream-rpms
              - rhel-8-for-x86_64-baseos-rpms
              - codeready-builder-for-rhel-8-x86_64-rpms
            state: enabled
          when: ansible_distribution == "RedHat"

        - name: Install EPEL repository
          dnf:
            name: "{{ epel_repo_url }}"
            state: present
            disable_gpg_check: yes

        - name: Add NVIDIA CUDA repository
          get_url:
            url: "{{ cuda_repo_url }}"
            dest: /etc/yum.repos.d/cuda-rhel8.repo
            mode: '0644'

        - name: Import NVIDIA GPG key
          rpm_key:
            key: https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/D42D0685.pub
            state: present

    # Install prerequisites
    - name: Install required packages
      dnf:
        name:
          - dkms
          - gcc
          - make
          - "kernel-devel-{{ ansible_kernel }}"
          - "kernel-headers-{{ ansible_kernel }}"
          - elfutils-libelf-devel
        state: present

    # Clean and prepare for installation
    - name: Clean package manager cache
      command: dnf clean all
      changed_when: true

    - name: Remove conflicting packages
      dnf:
        name:
          - xorg-x11-drv-nouveau
        state: absent
      failed_when: false

    # Install NVIDIA driver
    - name: Install NVIDIA driver
      block:
        - name: Reset NVIDIA module if exists
          command: dnf module reset nvidia-driver -y
          failed_when: false

        - name: Enable appropriate NVIDIA module stream
          command: "dnf module enable nvidia-driver:{{ kernel_module_type }}-dkms -y"

        - name: Install NVIDIA driver packages (Open modules)
          dnf:
            name:
              - nvidia-open
              - nvidia-settings
              - nvidia-xconfig
            state: present
            allowerasing: yes
          when: kernel_module_type == "open"

        - name: Install NVIDIA driver packages (Proprietary modules)
          dnf:
            name:
              - cuda-drivers
              - nvidia-settings
              - nvidia-xconfig
            state: present
            allowerasing: yes
          when: kernel_module_type == "proprietary"

        - name: Log installation completion
          lineinfile:
            path: "{{ log_file }}"
            line: "NVIDIA driver packages installed successfully"

    # Configure NVIDIA settings
    - name: Configure NVIDIA driver
      block:
        - name: Enable NVIDIA persistence daemon
          systemd:
            name: nvidia-persistenced
            enabled: yes
            daemon_reload: yes

        - name: Create NVIDIA configuration directory
          file:
            path: /etc/X11/xorg.conf.d
            state: directory
            mode: '0755'

        - name: Generate basic NVIDIA X configuration
          copy:
            content: |
              Section "Device"
                  Identifier "Device0"
                  Driver "nvidia"
                  VendorName "NVIDIA Corporation"
              EndSection
            dest: /etc/X11/xorg.conf.d/10-nvidia.conf
            mode: '0644'
          when: ansible_env.DISPLAY is defined

    # Build kernel modules if needed
    - name: Build NVIDIA kernel modules with DKMS
      command: dkms autoinstall
      register: dkms_result
      failed_when: false

    # Verification and reboot handling
    - name: Check if reboot is required
      stat:
        path: /var/run/reboot-required
      register: reboot_check

    - name: Test NVIDIA driver without reboot
      command: nvidia-smi
      register: nvidia_test
      failed_when: false
      changed_when: false

    - name: Handle reboot if needed
      block:
        - name: Notify about pending reboot
          debug:
            msg: "System reboot is required to complete NVIDIA driver installation"

        - name: Reboot system if auto-reboot enabled
          reboot:
            msg: "Rebooting to complete NVIDIA driver installation"
            reboot_timeout: 600
            post_reboot_delay: 30
          when: enable_auto_reboot

        - name: Wait for system to come back online
          wait_for_connection:
            delay: 30
            timeout: 300
          when: enable_auto_reboot

        - name: Verify NVIDIA driver after reboot
          command: nvidia-smi
          register: nvidia_verify
          when: enable_auto_reboot
          retries: 3
          delay: 10

      when: nvidia_test.rc != 0 or reboot_check.stat.exists | default(false)

    # Final verification and reporting
    - name: Generate installation report
      block:
        - name: Get new driver version
          shell: nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1
          register: new_driver_version
          failed_when: false

        - name: Get GPU information
          shell: nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null
          register: gpu_details
          failed_when: false

        - name: Create installation report
          copy:
            content: |
              NVIDIA Driver Installation Report
              =================================
              Date: {{ ansible_date_time.iso8601 }}
              Hostname: {{ ansible_hostname }}
              
              Installation Details:
              - Driver Branch: {{ nvidia_driver_branch }}
              - Kernel Module Type: {{ kernel_module_type }}
              - Previous Version: {{ old_driver_version.stdout | default('Not installed') }}
              - Current Version: {{ new_driver_version.stdout | default('Installation pending reboot') }}
              
              GPU Information:
              {{ gpu_details.stdout | default('GPU information will be available after reboot') }}
              
              Status: {{ 'Success' if nvidia_test.rc == 0 or (nvidia_verify.rc | default(1)) == 0 else 'Pending reboot' }}
            dest: "/root/nvidia_installation_report_{{ ansible_date_time.epoch }}.txt"
            mode: '0644'

        - name: Display installation summary
          debug:
            msg: |
              ========================================
              NVIDIA Driver Installation Complete
              ========================================
              Driver Version: {{ new_driver_version.stdout | default('Pending reboot') }}
              Status: {{ 'Active' if nvidia_test.rc == 0 or (nvidia_verify.rc | default(1)) == 0 else 'Requires reboot' }}
              
              {% if nvidia_test.rc != 0 and not enable_auto_reboot %}
              ACTION REQUIRED: Please reboot the system manually to activate the driver
              Run: sudo reboot
              {% endif %}

    # Cleanup
    - name: Log installation completion
      lineinfile:
        path: "{{ log_file }}"
        line: "=== Installation completed at {{ ansible_date_time.iso8601 }} ==="

  handlers:
    - name: restart nvidia-persistenced
      systemd:
        name: nvidia-persistenced
        state: restarted
