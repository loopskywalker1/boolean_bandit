class GPUDataGenerator:
    """GPU-accelerated data generation for causal inference."""
    
    def __init__(self, use_gpu=True):
        self.use_gpu = use_gpu and GPU_AVAILABLE
        self.xp = cp if self.use_gpu else np
        
    def set_dgp(self, dgp_string):
        """Set the data generating process functions."""
        
        def mu0_constant(X):
            return self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10 - 3
        
        def mu1_constant(X):
            return self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10
        
        def mu0_heterogeneous(X):
            return self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10 ** 2 - 30.00103
        
        def mu1_heterogeneous(X):
            return self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10
        
        def mu0_dgp3(X):
            return (X[:, 0]**2 + 
                   2.4 * X[:, 2] + 
                   X[:, 4] - 
                   self.xp.sqrt(self.xp.abs(X[:, 0])))
        
        def mu1_dgp3(X):
            return (X[:, 0]**2 + 
                   2*X[:, 1] - 
                   0.2 * X[:, 2] + 
                   X[:, 4] - 
                   self.xp.sqrt(self.xp.abs(X[:, 0])))
        
        dgp_functions = {
            'constant': (mu0_constant, mu1_constant),
            'heterogeneous': (mu0_heterogeneous, mu1_heterogeneous),
            'dgp3': (mu0_dgp3, mu1_dgp3)
        }
        
        return dgp_functions.get(dgp_string, dgp_functions['dgp3'])
    
    def dgp(self, n, y_noise=6, dgp_string="dgp3", rng=None):
        """Generate synthetic causal inference data on GPU."""
        if rng is None:
            if self.use_gpu:
                # Use CuPy's random state
                rng_state = cp.random.get_random_state()
            else:
                rng_state = np.random.RandomState()
        else:
            rng_state = rng
        
        # Generate covariates uniformly between -1 and 1
        if self.use_gpu:
            X = rng_state.uniform(-1, 1, size=(n, 5))
        else:
            X = rng_state.uniform(-1, 1, size=(n, 5))
        
        # Get DGP functions
        mu0_func, mu1_func = self.set_dgp(dgp_string)
        
        # Generate potential outcomes with noise
        Y0 = mu0_func(X) + rng_state.normal(0, y_noise, n)
        Y1 = mu1_func(X) + rng_state.normal(0, y_noise, n)
        
        # Randomly assign treatment with 50% probability
        A = rng_state.binomial(1, 0.5, n)
        
        # Observed outcome depends on treatment assignment
        Y = A * Y1 + (1 - A) * Y0
        
        # Convert to CPU if using GPU for easier DataFrame creation
        if self.use_gpu:
            X = cp.asnumpy(X)
            Y = cp.asnumpy(Y)
            Y0 = cp.asnumpy(Y0)
            Y1 = cp.asnumpy(Y1)
            A = cp.asnumpy(A)
        
        # Create DataFrame
        data = pd.DataFrame({
            'W1': X[:, 0], 'W2': X[:, 1], 'W3': X[:, 2], 'W4': X[:, 3], 'W5': X[:, 4],
            'A': A, 'Y': Y, 'Y0': Y0, 'Y1': Y1
        })
        
        return data

