def get_hist_dat(n_hist, y_noise=6, dgp_string="dgp3", rng=None):
    """Generate historical data and split into training/test sets."""
    if rng is None:
        rng = MAIN_RNG
    
    data_gen = GPUDataGenerator(use_gpu=GPU_AVAILABLE)
    data = data_gen.dgp(n=n_hist, y_noise=y_noise, dgp_string=dgp_string, rng=rng)
    
    # Split 70/30 like R's initial_split
    train_indices = rng.choice(n_hist, size=int(0.7 * n_hist), replace=False)
    train_df = data.iloc[train_indices].reset_index(drop=True)
    test_df = data.drop(train_indices).reset_index(drop=True)
    
    logger.debug(f"Historical data split: {train_df.shape[0]} train, {test_df.shape[0]} test")
    
    return train_df, test_df

def calc_kappa(prog_model, test_dat):
    """Calculate RMSE on test data using prognostic model."""
    best_learner_name, fitted_model, _ = prog_model
    
    X_test = test_dat.filter(like='W')
    y_true = test_dat['Y']
    
    try:
        if GPU_AVAILABLE and '_gpu' in best_learner_name:
            try:
                X_test_gpu = cudf.from_pandas(X_test)
                y_pred = fitted_model.predict(X_test_gpu)
                if hasattr(y_pred, 'values'):
                    y_pred = y_pred.values
                y_pred = cp.asnumpy(y_pred) if isinstance(y_pred, cp.ndarray) else y_pred
            except:
                y_pred = fitted_model.predict(X_test)
        else:
            y_pred = fitted_model.predict(X_test)
    except Exception as e:
        logger.error(f"Prediction failed in calc_kappa: {e}")
        return float('inf')
    
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    return rmse

