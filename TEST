        # TMLE fit
        tmle_fit = results_df[(results_df['n_trial'] == n) & 
                             (results_df['estimator'] == 'tmle_fit')].iloc[0]
        print(f"{row:2d}  {tmle_fit['avg_effect']:8.5f} {tmle_fit['avg_se']:8.5f}  fit     tmle        discrete_sl    {n:4d}")
        row += 1


def main():
    """Main function to run complete power simulation"""
    
    # Configuration
    CONFIG = {
        'dgp_string': 'dgp3',
        'n_hist': 2000,
        'y_noise': 6,
        'V': 10,
        'n_runs': 200,
        'n_workers': min(8, os.cpu_count()),
        'base_seed': 129483,
        'experimental_seed': 3021377
    }
    
    # Set base seed
    np.random.seed(CONFIG['base_seed'])
    
    # Generate historical data
    logger.info("Generating historical data...")
    data_gen = DataGenerator()
    hist_data = data_gen.generate_data(
        n=CONFIG['n_hist'],
        y_noise=CONFIG['y_noise'],
        dgp_string=CONFIG['dgp_string']
    )
    
    # Split 70/30
    n_train = int(0.7 * CONFIG['n_hist'])
    train_idx = np.random.choice(CONFIG['n_hist'], size=n_train, replace=False)
    test_idx = np.setdiff1d(np.arange(CONFIG['n_hist']), train_idx)
    
    train_data = hist_data.iloc[train_idx].reset_index(drop=True)
    test_data = hist_data.iloc[test_idx].reset_index(drop=True)
    
    logger.info(f"Training data: {len(train_data)} observations")
    logger.info(f"Test data: {len(test_data)} observations")
    
    # Fit prognostic model
    logger.info("Fitting prognostic model...")
    model_selector = ModelSelector()
    prog_model = model_selector.fit_prog(train_data, V=CONFIG['V'])
    
    # Calculate kappa on test set
    feature_cols = ['W1', 'W2', 'W3', 'W4', 'W5', 'W6']
    y_pred = prog_model[1].predict(test_data[feature_cols])
    kappa3 = np.sqrt(mean_squared_error(test_data['Y'], y_pred))
    
    # Calculate metrics on combined data
    sig3, sigma03, sigma13, gamma3 = calculate_metrics(hist_data)
    
    logger.info(f"\nMetrics:")
    logger.info(f"Best model: {prog_model[0]}")
    logger.info(f"kappa3 = {kappa3:.6f}")
    logger.info(f"sig3 = {sig3:.5f}")
    logger.info(f"sigma03 = {sigma03:.5f}")
    logger.info(f"sigma13 = {sigma13:.5f}")
    logger.info(f"gamma3 = {gamma3:.6f}")
    
    # Sample sizes for experiments
    n_trials = [100, 150, 200, 250, 300, 350, 400, 450, 500, 
                600, 700, 800, 900, 1000]
    
    # Create parameter grid
    all_params = []
    for n_trial in n_trials:
        for run in range(CONFIG['n_runs']):
            all_params.append({
                'n_trial': n_trial,
                'prog_model': prog_model,
                'kappa': kappa3,
                'sig': sig3,
                'y_noise': CONFIG['y_noise'],
                'dgp_string': CONFIG['dgp_string'],
                'run': run,
                'seed': CONFIG['experimental_seed']
            })
    
    logger.info(f"\nRunning {len(all_params)} experiments...")
    
    # Run experiments in parallel
    results = []
    with ProcessPoolExecutor(max_workers=CONFIG['n_workers']) as executor:
        futures = [executor.submit(run_single_experiment, params) 
                  for params in all_params]
        
        for future in tqdm(as_completed(futures), total=len(futures)):
            try:
                result = future.result()
                results.append(result)
            except Exception as e:
                logger.error(f"Experiment failed: {e}")
    
    # Convert to DataFrame
    results_df = pd.DataFrame(results)
    
    # Calculate power by sample size and estimator
    power_results = []
    for n_trial in n_trials:
        trial_results = results_df[results_df['n_trial'] == n_trial]
        
        # Unadjusted
        power_results.append({
            'n_trial': n_trial,
            'estimator': 'unadjusted',
            'power': trial_results['unadj_sig'].mean(),
            'avg_effect': trial_results['unadj_effect'].mean(),
            'avg_se': trial_results['unadj_se'].mean()
        })
        
        # TMLE none
        power_results.append({
            'n_trial': n_trial,
            'estimator': 'tmle_none',
            'power': trial_results['tmle_none_sig'].mean(),
            'avg_effect': trial_results['tmle_none_effect'].mean(),
            'avg_se': trial_results['tmle_none_se'].mean()
        })
        
        # TMLE fit
        power_results.append({
            'n_trial': n_trial,
            'estimator': 'tmle_fit',
            'power': trial_results['tmle_fit_sig'].mean(),
            'avg_effect': trial_results['tmle_fit_effect'].mean(),
            'avg_se': trial_results['tmle_fit_se'].mean()
        })
    
    power_df = pd.DataFrame(power_results)
    
    # Create visualization
    create_power_plot(power_df, kappa3, sig3, sigma03, sigma13)
    
    # Print results table
    print_results_table(power_df)
    
    # Save results
    output_dir = Path('results')
    output_dir.mkdir(exist_ok=True)
    
    results_df.to_csv(output_dir / 'experiment_results.csv', index=False)
    power_df.to_csv(output_dir / 'power_results.csv', index=False)
    
    # Save metrics
    metrics_df = pd.DataFrame({
        'metric': ['kappa3', 'sig3', 'sigma03', 'sigma13', 'gamma3'],
        'value': [kappa3, sig3, sigma03, sigma13, gamma3]
    })
    metrics_df.to_csv(output_dir / 'metrics.csv', index=False)
    
    logger.info(f"\nResults saved to {output_dir}")
    logger.info("Simulation complete!")
    
    return results_df, power_df, kappa3, sig3, sigma03, sigma13, gamma3


if __name__ == "__main__":
    results_df, power_df, kappa3, sig3, sigma03, sigma13, gamma3 = main()
