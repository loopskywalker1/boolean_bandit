---
- name: Simple security tools status check with wildcards
  hosts: all
  become: yes
  vars:
    tools:
      - { name: "BigFix", search: "etaclient|besagent|bigfix" }
      - { name: "CrowdStrike", search: "falcon|crowdstrike" }
      - { name: "Qualys", search: "qualys" }
      - { name: "Splunk", search: "splunk" }
      - { name: "Tanium", search: "tanium" }

  tasks:
    - name: Check each security tool
      ansible.builtin.shell: |
        service=$(systemctl list-units --type=service --all | grep -iE "{{ item.search }}" | head -1 | awk '{print $1}')
        if [ -n "$service" ]; then
          if systemctl is-active "$service" >/dev/null 2>&1; then
            echo "INSTALLED - RUNNING"
          else
            echo "INSTALLED - NOT RUNNING"
          fi
        else
          echo "NOT INSTALLED"
        fi
      loop: "{{ tools }}"
      register: status_check
      changed_when: false
      failed_when: false

    - name: Display results
      ansible.builtin.debug:
        msg: "{{ item.item.name }}: {{ item.stdout }}"
      loop: "{{ status_check.results }}"
