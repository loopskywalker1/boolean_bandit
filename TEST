---
- name: Check NVIDIA SMI installation
  hosts: all
  become: yes

  tasks:
    - name: Check if nvidia-smi is installed and working
      ansible.builtin.shell: |
        if command -v nvidia-smi >/dev/null 2>&1; then
          if nvidia-smi >/dev/null 2>&1; then
            echo "INSTALLED - WORKING"
          else
            echo "INSTALLED - NOT WORKING"
          fi
        else
          echo "NOT INSTALLED"
        fi
      register: nvidia_status
      changed_when: false
      failed_when: false

    - name: Display nvidia-smi status
      ansible.builtin.debug:
        msg: "NVIDIA SMI: {{ nvidia_status.stdout }}"
