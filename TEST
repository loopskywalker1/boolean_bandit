# Fleet configuration for dords Helm chart - Production
defaultNamespace: core

# Target only prod cluster(s)
targets:
- name: prod
  clusterSelector:
    matchLabels:
      env: prod

# Helm configuration for production
helm:
  # Chart path - go up two directories then into dords folder
  chart: "../../dords"
  
  # Release name
  releaseName: dords
  
  # Values file for production (relative to the chart root)
  valuesFiles:
  - values-prod.yaml
  
  # Production-specific settings
  force: false
  maxHistory: 10
  timeout: 15m
  wait: true
  atomic: true

# Slower polling for production
pollingInterval: 60s

# Very careful rollout for production
rolloutStrategy:
  autoPartitionSize: 25%
  maxUnavailable: 0
  maxUnavailablePartitions: 1

# Production-specific diff configuration
diff:
  comparePatches:
  - apiVersion: apps/v1
    kind: Deployment
    operations:
    - {"op": "remove", "path": "/spec/replicas"}
    - {"op": "remove", "path": "/metadata/labels/cattle.io~1os"}

