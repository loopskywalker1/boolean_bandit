---
- name: Simple security tools status check
  hosts: all
  become: yes
  vars:
    security_services:
      - { name: "BigFix", service: "etaclient" }
      - { name: "CrowdStrike", service: "falcon-sensor" }
      - { name: "Qualys", service: "qualys-cloud-agent" }
      - { name: "Splunk", service: "splunkd" }
      - { name: "Tanium", service: "tanium" }

  tasks:
    - name: Check if services exist and their status
      ansible.builtin.systemd:
        name: "{{ item.service }}"
      register: service_check
      failed_when: false
      loop: "{{ security_services }}"

    - name: Display simple status
      ansible.builtin.debug:
        msg: "{{ item.item.name }}: {% if item.status.LoadState == 'loaded' %}INSTALLED - {% if item.status.ActiveState == 'active' %}RUNNING{% else %}NOT RUNNING{% endif %}{% else %}NOT INSTALLED{% endif %}"
      loop: "{{ service_check.results }}"
