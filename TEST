# Utility functions
def ensure_dir_exists(directory):
    """Create directory if it doesn't exist"""
    if not os.path.exists(directory):
        os.makedirs(directory, exist_ok=True)
        logging.info(f"Created directory: {directory}")
    return directory

# Data generation functions
def generate_data(n_hist=1000, y_noise=6, dgp_string="dgp3"):
    """Generate synthetic data similar to your R code"""
    np.random.seed(129483)  # Same as set.seed in R
    
    # Generate features
    W1 = np.random.uniform(-1, 1, n_hist)
    W2 = np.random.uniform(-1, 1, n_hist)
    W3 = np.random.uniform(-1, 1, n_hist)
    W4 = np.random.uniform(-1, 1, n_hist)
    W5 = np.random.uniform(-1, 1, n_hist)
    
    # Generate treatment assignment
    A = np.random.binomial(1, 0.5, n_hist)
    
    # Different DGP functions as in your R code
    if dgp_string == "dgp3":
        mu0 = W1**2 + 2.4 * W3 + W5 - np.sqrt(np.abs(W1))
        mu1 = W1**2 + 2*W2 - 0.2 * W3 + W5 - np.sqrt(np.abs(W1))
    elif dgp_string == "constant":
        mu0 = np.sin(np.abs(W1)*np.pi/10) - 3
        mu1 = np.sin(np.abs(W1)*np.pi/10)
    else:
        # Default case
        mu0 = W1 + W2 + W3**2 / 1.5
        mu1 = W1 + W2 + W3**2 / 1.2 + 2.582
    
    # Add noise
    Y0 = mu0 + np.random.normal(0, y_noise, n_hist)
    Y1 = mu1 + np.random.normal(0, y_noise, n_hist)
    
    # Observed outcome based on treatment
    Y = A * Y1 + (1 - A) * Y0
    
    # Create dataframe
    data = pd.DataFrame({
        'W1': W1, 'W2': W2, 'W3': W3, 'W4': W4, 'W5': W5,
        'A': A, 'Y': Y, 'Y0': Y0, 'Y1': Y1
    })
    
    return data

# Equivalent to the estimators in R
def unadjusted_estimator(data):
    """Unadjusted estimator similar to your R code"""
    y1_mean = data[data['A'] == 1]['Y'].mean()
    y0_mean = data[data['A'] == 0]['Y'].mean()
    effect = y1_mean - y0_mean
    
    # Calculate SE
    y1_var = data[data['A'] == 1]['Y'].var()
    y0_var = data[data['A'] == 0]['Y'].var()
    n1 = (data['A'] == 1).sum()
    n0 = (data['A'] == 0).sum()
    se = np.sqrt(y1_var/n1 + y0_var/n0)
    
    return {'effect': effect, 'se': se}

def linear_estimator(data):
    """Linear regression estimator - FIXED to avoid dimension mismatch"""
    # Create a copy of the data to avoid modifying the original
    train_data = data.copy()
    
    # Include A in the training features
    X = train_data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = train_data['Y']
    
    # Fit model with A included in the features
    model = LinearRegression()
    model.fit(X, y)
    
    # Create datasets for counterfactual prediction
    all_X = train_data[['W1', 'W2', 'W3', 'W4', 'W5']].copy()
    
    # Create X with A=1 for all observations
    X1 = all_X.copy()
    X1['A'] = 1
    
    # Create X with A=0 for all observations
    X0 = all_X.copy()
    X0['A'] = 0
    
    # Predict counterfactuals
    y1_pred = model.predict(X1)
    y0_pred = model.predict(X0)
    
    # Calculate effect
    effect = (y1_pred - y0_pred).mean()
    se = np.std(y1_pred - y0_pred) / np.sqrt(len(y))
    
    return {'effect': effect, 'se': se}

def gbt_estimator(data):
    """Gradient Boosted Trees estimator - FIXED to avoid dimension mismatch"""
    # Include A in the training features
    X = data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = data['Y']
    
    # Fit model
    model = GradientBoostingRegressor(
        n_estimators=100, 
        max_depth=3,
        learning_rate=0.1
    )
    model.fit(X, y)
    
    # Create datasets for counterfactual prediction
    all_X = data[['W1', 'W2', 'W3', 'W4', 'W5']].copy()
    
    # Create X with A=1 for all observations
    X1 = all_X.copy()
    X1['A'] = 1
    
    # Create X with A=0 for all observations
    X0 = all_X.copy()
    X0['A'] = 0
    
    # Predict counterfactuals
    y1_pred = model.predict(X1)
    y0_pred = model.predict(X0)
    
    # Calculate effect
    effect = (y1_pred - y0_pred).mean()
    se = np.std(y1_pred - y0_pred) / np.sqrt(len(y))
    
    return {'effect': effect, 'se': se}

def knn_estimator(data):
    """K-Nearest Neighbors estimator - FIXED to avoid dimension mismatch"""
    # Include A in the training features
    X = data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = data['Y']
    
    # Fit model
    model = KNeighborsRegressor(n_neighbors=5)
    model.fit(X, y)
    
    # Create datasets for counterfactual prediction
    all_X = data[['W1', 'W2', 'W3', 'W4', 'W5']].copy()
    
    # Create X with A=1 for all observations
    X1 = all_X.copy()
    X1['A'] = 1
    
    # Create X with A=0 for all observations
    X0 = all_X.copy()
    X0['A'] = 0
    
    # Predict counterfactuals
    y1_pred = model.predict(X1)
    y0_pred = model.predict(X0)
    
    # Calculate effect
    effect = (y1_pred - y0_pred).mean()
    se = np.std(y1_pred - y0_pred) / np.sqrt(len(y))
    
    return {'effect': effect, 'se': se}

# Cross-validation and model selection
def fit_prog(train_data, test_data=None, learners=None):
    """Fit prognostic models and evaluate"""
    if test_data is None:
        # If no test data provided, use train_data
        test_data = train_data
        
    if learners is None:
        learners = {
            'linear': linear_estimator,
            'gbt': gbt_estimator,
            'knn': knn_estimator,
            'unadjusted': unadjusted_estimator
        }
    
    results = {}
    for name, learner in learners.items():
        try:
            result = learner(train_data)
            results[name] = result
            logging.info(f"Learner {name}: effect={result['effect']:.4f}, se={result['se']:.4f}")
        except Exception as e:
            logging.error(f"Error in learner {name}: {str(e)}")
    
    # Select best learner based on SE (lower is better)
    if results:
        best_learner_name = min(results, key=lambda k: results[k]['se'])
        best_learner = learners[best_learner_name]
        logging.info(f"Selected best learner: {best_learner_name}")
        return best_learner, best_learner_name, results[best_learner_name]
    else:
        # Fallback to linear if all failed
        logging.warning("All learners failed, falling back to linear")
        return linear_estimator, "linear", {"effect": 0, "se": 1}

def calc_kappa(prog_mod, hist_data, test_data):
    """Calculate kappa metric"""
    # Apply the prognostic model to test data
    result = prog_mod(test_data)
    return result['effect'] / result['se']  # Return effect size normalized by SE

def run_experiment(run_index):
    """Run a single experiment"""
    worker_id = os.getpid()
    logging.info(f"Worker {worker_id} starting run {run_index}")
    
    try:
        # Generate data
        hist_data = generate_data(n_hist=1000, y_noise=6, dgp_string="dgp3")
        logging.info(f"Run {run_index}: Generated data with shape {hist_data.shape}")
        
        # Train-test split
        hist_train, hist_test = train_test_split(hist_data, test_size=0.3, random_state=129483)
        
        # Fit prognostic model
        prog, best_learner_name, prog_result = fit_prog(hist_train, hist_test)
        logging.info(f"Run {run_index}: Fitted prognostic model {best_learner_name}")
        
        # Calculate kappa
        kappa = calc_kappa(prog, hist_data, hist_test)
        logging.info(f"Run {run_index}: Calculated kappa = {kappa}")
        
        # Calculate sig3 (equivalent to your R code)
        sig3 = np.std(hist_data[hist_data['A'] == 1]['Y'] - hist_data[hist_data['A'] == 0]['Y'])
        
        # Prepare results
        result = pd.DataFrame({
            'run_index': [run_index],
            'kappa': [kappa],
            'best_learner_name': [best_learner_name],
            'effect': [prog_result['effect']],
            'se': [prog_result['se']],
            'sig3': [sig3],
            'timestamp': [time.time()]
        })
        
        # Save results
        res_dir = ensure_dir_exists(os.path.join('results', 'dpg3_mini', 'base_run', 'experiments'))
        timestamp = time.strftime("%H%M%S")
        output_filename = f"experiment_result_run_{run_index}_worker{worker_id}_{timestamp}.parquet"
        output_path = os.path.join(res_dir, output_filename)
        
        # Convert to pyarrow table and write
        table = pa.Table.from_pandas(result)
        pq.write_table(table, output_path)
        logging.info(f"Worker {worker_id} successfully wrote file for run {run_index} to {output_path}")
        return run_index
        
    except Exception as e:
        logging.error(f"Worker {worker_id} failed in run {run_index}: {str(e)}", exc_info=True)
        return None

def main():
    """Main function to run experiments in parallel"""
    n_runs = 8
    logging.info(f"Starting {n_runs} experiments in parallel")
    
    # Use all available cores for parallelism
    n_workers = min(os.cpu_count(), n_runs)
    logging.info(f"Using {n_workers} worker processes")
    
    # Create result directory
    res_dir = ensure_dir_exists(os.path.join('results', 'dpg3_mini', 'base_run', 'experiments'))
    
    # Run experiments in parallel using ProcessPoolExecutor
    with ProcessPoolExecutor(max_workers=n_workers) as executor:
        futures = [executor.submit(run_experiment, i) for i in range(1, n_runs + 1)]
        results = []
        for future in futures:
            try:
                result = future.result()
                results.append(result)
            except Exception as e:
                logging.error(f"Error in future: {str(e)}")
    
    # Check results
    completed = [r for r in results if r is not None]
    logging.info(f"Completed {len(completed)} out of {n_runs} experiments")
    
    # List created files
    files = os.listdir(res_dir)
    parquet_files = [f for f in files if f.startswith('experiment_result_run_') and f.endswith('.parquet')]
    logging.info(f"Created {len(parquet_files)} parquet files")
    for file in parquet_files[:5]:  # Show the first 5 files
        logging.info(f"  - {file}")
    
    if len(parquet_files) < n_runs:
        logging.warning(f"Expected {n_runs} files but only found {len(parquet_files)}")

if __name__ == "__main__":
    # Initialize multiprocessing without explicitly setting start method
    # to avoid potential issues on different platforms
    main()
