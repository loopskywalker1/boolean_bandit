# First, ensure res_dir is defined before run_experiment is called
# Add this near the top of your base_run_mini.R file
res_dir <- paste('results', 'dpg3_mini', 'base_run', 'experiments', sep='/')
ensure_dir_exists(res_dir)  # Make sure this function is defined

# Then modify run_experiment function to add worker ID to filename
run_experiment <- function(run_index) {
  # Your existing code
  result <- params %>% pmap_df(experiment,
    hist_lrnr = prog3,
    y_noise = 6,
    dgp_string = "dgp3",
    V = 20)
  
  result$seed <- experimental_seed
  
  # Add uniqueness to prevent conflicts
  worker_id <- Sys.getpid()  # Get process ID
  timestamp <- format(Sys.time(), "%H%M%S")
  output_filename <- paste0("experiment_result_run_", run_index, "_worker", worker_id, "_", timestamp, ".parquet")
  
  # Use file.path for proper path construction
  full_path <- file.path(res_dir, output_filename)
  
  # Optional debugging output
  cat(paste0("Writing file for run ", run_index, " to: ", full_path, "\n"))
  
  # Write with error handling
  tryCatch({
    write_parquet(result, full_path)
    cat(paste0("Successfully wrote file for run ", run_index, "\n"))
  }, error = function(e) {
    cat(paste0("ERROR writing file for run ", run_index, ": ", e$message, "\n"))
  })
  
  return(run_index)
}

