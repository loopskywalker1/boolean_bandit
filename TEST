class DataGeneratingProcess:
    """Python equivalent of R's DGP functions"""
    
    def __init__(self, dgp_string="constant"):
        self.dgp_string = dgp_string
        print(f"Initialized DGP with type: {dgp_string}")
    
    def generate_data(self, n=1000, y_noise=6):
        """
        Python equivalent of R's dgp() function
        Generates synthetic data based on the specified DGP
        """
        np.random.seed(42)
        
        # Generate covariates (equivalent to R's matrix generation)
        w1_lbound = -2
        w1_ubound = 1
        o_lbound = 0
        u_ubound = 1
        
        # Generate random variables (equivalent to R's runif, rnorm, etc.)
        w1 = np.random.uniform(w1_lbound, w1_ubound, n)
        w2 = np.random.normal(0, 3, n)
        w3 = np.random.uniform(-1, 1, n)
        w4 = np.random.gamma(2, 2, n)
        w5 = np.random.gamma(2, 1, n)
        w6 = np.random.normal(1, 2, n)
        
        # Create DataFrame (equivalent to R's tibble)
        data = pd.DataFrame({
            'w1': w1, 'w2': w2, 'w3': w3, 'w4': w4, 'w5': w5, 'w6': w6
        })
        
        # Add treatment assignment and outcome generation
        # This is a simplified version - the R code has complex mu0/mu1 functions
        if self.dgp_string == "constant":
            # Simple linear relationship
            y0 = w1 + w2 + np.random.normal(0, y_noise, n)
            y1 = w1 + w2 + 2.0 + np.random.normal(0, y_noise, n)  # Treatment effect of 2
        elif self.dgp_string == "heterogeneous":
            # Heterogeneous treatment effects
            treatment_effect = 0.5 + 0.5 * w1 + 0.3 * w2
            y0 = w1 + w2 + np.random.normal(0, y_noise, n)
            y1 = y0 + treatment_effect + np.random.normal(0, y_noise, n)
        else:
            # Default case
            y0 = w1 + w2 + np.random.normal(0, y_noise, n)
            y1 = w1 + w2 + 1.5 + np.random.normal(0, y_noise, n)
        
        # Random treatment assignment (equivalent to R's rbinom)
        a = np.random.binomial(1, 0.5, n)
        data['a'] = a
        
        # Observed outcome (equivalent to R's ifelse)
        y = np.where(a == 1, y1, y0)
        data['y'] = y
        data['y0'] = y0  # Potential outcome under control
        data['y1'] = y1  # Potential outcome under treatment
        
        return data

