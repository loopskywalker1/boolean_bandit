def knn_estimator(data):
    """K-Nearest Neighbors estimator"""
    X = data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = data['Y']
    
    # Fit model
    model = KNeighborsRegressor(n_neighbors=5)
