# Utility functions
def ensure_dir_exists(dir_path):
    """Create directory if it doesn't exist"""
    if not os.path.exists(dir_path):
        os.makedirs(dir_path, exist_ok=True)
        logging.info(f"Making {dir_path}")
    else:
        logging.info(f"Dir path {dir_path} already present")
    return dir_path

# Data generation functions
def set_dgp(dgp_string='constant'):
    """Set the data generating process based on dgp_string"""
    def mu0_constant(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10) - 3
    
    def mu1_constant(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)
    
    def mu0_heterogeneous(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)**2 - 30.00103
    
    def mu1_heterogeneous(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)
    
    def mu0_dgp3(X):
        return X[:, 0]**2 + 2.4 * X[:, 2] + X[:, 4] - np.sqrt(np.abs(X[:, 0]))
    
    def mu1_dgp3(X):
        return X[:, 0]**2 + 2*X[:, 1] - 0.2 * X[:, 2] + X[:, 4] - np.sqrt(np.abs(X[:, 0]))
    
    dgp_functions = {
        'constant': (mu0_constant, mu1_constant),
        'heterogeneous': (mu0_heterogeneous, mu1_heterogeneous),
        'dgp3': (mu0_dgp3, mu1_dgp3)
    }
    
    return dgp_functions.get(dgp_string, dgp_functions['dgp3'])

def dgp(n, y_noise=0):
    """Generate data with specified noise level"""
    # Bounds for the features
    W1_bound, W1_ubound = -1, 1
    W2_bound, W2_ubound = -1, 1
    W3_bound, W3_ubound = -1, 1
    W4_bound, W4_ubound = -1, 1
    W5_bound, W5_ubound = -1, 1
    
    # Generate features
    W1 = np.random.uniform(W1_bound, W1_ubound, n)
    W2 = np.random.uniform(W2_bound, W2_ubound, n)
    W3 = np.random.uniform(W3_bound, W3_ubound, n)
    W4 = np.random.uniform(W4_bound, W4_ubound, n)
    W5 = np.random.uniform(W5_bound, W5_ubound, n)
    
    # Create a dataframe
    data = pd.DataFrame({
        'W1': W1, 'W2': W2, 'W3': W3, 'W4': W4, 'W5': W5
    })
    
    # Return the dataframe
    return data

def get_hist_dat(n_hist=1000, y_noise=6, dgp_string="dgp1"):
    """Generate historical data similar to the R get_hist_dat function"""
    # Set the data generating process
    mu0_func, mu1_func = set_dgp(dgp_string)
    
    # Generate data
    data_hist = dgp(n=n_hist)
    
    # Generate treatment indicator
    A = np.random.binomial(1, 0.5, n_hist)
    data_hist['A'] = A
    
    # Features as numpy array for mu functions
    X = data_hist[['W1', 'W2', 'W3', 'W4', 'W5']].values
    
    # Generate outcomes based on treatment
    mu0 = mu0_func(X)
    mu1 = mu1_func(X)
    
    # Add noise
    Y0 = mu0 + np.random.normal(0, y_noise, n_hist)
    Y1 = mu1 + np.random.normal(0, y_noise, n_hist)
    
    # Observed outcome
    Y = A * Y1 + (1 - A) * Y0
    
    # Add to dataframe
    data_hist['Y'] = Y
    data_hist['Y0'] = Y0
    data_hist['Y1'] = Y1
    
    # Select columns that start with W for prediction
    W_cols = [col for col in data_hist.columns if col.startswith('W')]
    
    # Initial split of data (equivalent to R's initial_split)
    train_idx = np.random.choice(n_hist, int(0.7 * n_hist), replace=False)
    test_idx = np.array([i for i in range(n_hist) if i not in train_idx])
    
    hist_train = data_hist.iloc[train_idx].reset_index(drop=True)
    hist_test = data_hist.iloc[test_idx].reset_index(drop=True)
    
    return hist_train, hist_test

def unadjusted_estimator(data):
    """Unadjusted estimator similar to the R code"""
    y1_mean = data[data['A'] == 1]['Y'].mean()
    y0_mean = data[data['A'] == 0]['Y'].mean()
    effect = y1_mean - y0_mean
    
    # Calculate SE
    y1_var = data[data['A'] == 1]['Y'].var()
    y0_var = data[data['A'] == 0]['Y'].var()
    n1 = (data['A'] == 1).sum()
    n0 = (data['A'] == 0).sum()
    se = np.sqrt(y1_var/n1 + y0_var/n0)
    
    return {'effect': effect, 'se': se}

def linear_estimator(data):
    """Linear regression estimator"""
    X = data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = data['Y']
    
    # Fit model
    model = LinearRegression()
    model.fit(X, y)
    
    # Create datasets for counterfactual prediction
    X1 = data[['W1', 'W2', 'W3', 'W4', 'W5']].copy()
    X1['A'] = 1
    X0 = data[['W1', 'W2', 'W3', 'W4', 'W5']].copy()
    X0['A'] = 0
    
    # Predict counterfactuals
    y1_pred = model.predict(X1)
    y0_pred = model.predict(X0)
    
    # Calculate effect
    effect = (y1_pred - y0_pred).mean()
    se = np.std(y1_pred - y0_pred) / np.sqrt(len(y))
    
    return {'effect': effect, 'se': se}

def gbt_estimator(data):
    """Gradient Boosted Trees estimator"""
    X = data[['W1', 'W2', 'W3', 'W4', 'W5', 'A']]
    y = data['Y']
    
    # Fit model
    model = GradientBoostingRegressor(
        n_estimators=100, 
        max_depth=3,
        learning_rate=0.1
