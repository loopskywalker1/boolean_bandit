class ParallelRunner:
    """Python equivalent of R's parallel cluster functions"""
    
    def __init__(self, n_workers=None):
        if n_workers is None:
            self.n_workers = min(os.cpu_count() - 1, 8)
        else:
            self.n_workers = n_workers
        
        print(f"Created parallel runner with {self.n_workers} workers")
    
    def run_parallel_experiments(self, n_runs=200, n_trials_list=[100, 200, 300, 400, 500], 
                                dgp_string="constant", y_noise=6):
        """
        Python equivalent of R's parallel experiment execution
        """
        print(f"Running {n_runs} experiments with {len(n_trials_list)} different sample sizes...")
        
        # Initialize experiment runner
        exp_runner = ExperimentRunner()
        
        # Generate historical data for learner training
        hist_data = exp_runner.dgp.generate_data(n=1000, y_noise=y_noise)
        hist_train, hist_test = train_test_split(hist_data, test_size=0.3, random_state=42)
        
        # Train historical learner
        print("Training historical learner...")
        hist_learner = exp_runner.model_selector.get_best_learner(hist_train)
        print(f"Best historical learner: {hist_learner['name']} (RMSE: {hist_learner['rmse']:.4f})")
        
        # Define single experiment function for parallel execution
        def run_experiment_batch(run_idx):
            """Function to run one batch of experiments"""
            np.random.seed(42 + run_idx)  # Ensure reproducibility
            
            batch_results = []
            for n_trial in n_trials_list:
                result = exp_runner.run_single_experiment(
                    n_trial=n_trial,
                    hist_lrnr=hist_learner,
                    y_noise=y_noise,
                    dgp_string=dgp_string
                )
                
                # Flatten results for each method
                for method, method_result in result.items():
                    method_result['run_idx'] = run_idx
                    batch_results.append(method_result)
            
            return batch_results
        
        # Run experiments in parallel
        print(f"Executing {n_runs} experiment batches in parallel...")
        all_results = Parallel(n_jobs=self.n_workers, verbose=1)(
            delayed(run_experiment_batch)(i) for i in tqdm(range(n_runs))
        )
        
        # Flatten results
        final_results = []
        for batch_results in all_results:
            final_results.extend(batch_results)
        
        # Convert to DataFrame and save
        results_df = pd.DataFrame(final_results)
        
        # Save results
        results_file = exp_runner.results_dir / f"experiment_results_{dgp_string}.parquet"
        results_df.to_parquet(results_file)
        
        print(f"\nExperiment completed!")
        print(f"Results saved to: {results_file}")
        print(f"Total experiments: {len(final_results)}")
        print(f"Mean treatment effect (unadjusted): {results_df[results_df['method'] == 'unadjusted']['effect'].mean():.4f}")
        
        return results_df

