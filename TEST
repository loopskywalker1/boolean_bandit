class ExperimentRunner:
    """Python equivalent of R's experiment functions"""
    
    def __init__(self, cache_dir="cache", results_dir="results"):
        self.cache_dir = Path(cache_dir)
        self.results_dir = Path(results_dir)
        self.cache_dir.mkdir(exist_ok=True)
        self.results_dir.mkdir(exist_ok=True)
        
        self.dgp = DataGeneratingProcess()
        self.model_selector = ModelSelector()
        self.estimators = TreatmentEffectEstimators()
    
    def get_trial_data(self, n_trial, hist_lrnr, y_noise=6, dgp_string="constant", return_m=False):
        """
        Python equivalent of R's get_trial_dat function
        """
        # Set DGP type
        self.dgp.dgp_string = dgp_string
        
        # Generate trial data
        if return_m:
            data_trial = self.dgp.generate_data(n=n_trial, y_noise=y_noise)
            return data_trial
        else:
            data_trial = self.dgp.generate_data(n=n_trial, y_noise=y_noise)
            
            # Apply learner predictions if specified
            if hist_lrnr is not None:
                feature_cols = hist_lrnr.get('feature_cols', ['w1', 'w2', 'w3', 'w4', 'w5', 'w6'])
                X_trial = data_trial[feature_cols]
                
                # Get predictions from historical learner
                predictions = hist_lrnr['model'].predict(X_trial)
                data_trial['prog'] = predictions
            
            return data_trial
    
    def run_single_experiment(self, n_trial, hist_lrnr, y_noise=6, dgp_string="constant", V=5):
        """
        Python equivalent of R's experiment function
        """
        # Generate trial data
        data_trial = self.get_trial_data(n_trial, hist_lrnr, y_noise, dgp_string)
        
        # Run different estimators
        results = {}
        
        # Unadjusted estimator
        unadj_result = self.estimators.unadjusted_estimator(data_trial)
        results['unadjusted'] = {
            'effect': unadj_result['effect'],
            'se': unadj_result['se'],
            'method': 'unadjusted'
        }
        
        # TMLE estimator (simplified)
        try:
            tmle_result = self.estimators.tmle_estimator(data_trial)
            results['tmle'] = {
                'effect': tmle_result['effect'],
                'se': tmle_result['se'],
                'method': 'tmle'
            }
        except Exception as e:
            print(f"TMLE failed: {e}")
            results['tmle'] = {
                'effect': np.nan,
                'se': np.nan,
                'method': 'tmle'
            }
        
        # Add experiment metadata
        for method in results:
            results[method].update({
                'n_trial': n_trial,
                'y_noise': y_noise,
                'dgp_string': dgp_string,
                'hist_learner': hist_lrnr['name'] if hist_lrnr else 'none'
            })
        
        return results

