class GPUModelSelector:
    """GPU-accelerated model selection for causal inference."""
    
    def __init__(self, use_gpu=True):
        self.use_gpu = use_gpu and GPU_AVAILABLE
        
    def get_candidate_learners(self):
        """Get candidate models with GPU support when available."""
        models = {}
        
        if self.use_gpu:
            try:
                # GPU models
                models.update({
                    'lasso_gpu': CuLasso(alpha=0.01, max_iter=10000),
                    'enet_gpu': CuLinearRegression(),  # CuML doesn't have ElasticNet, use LinearRegression
                    'ridge_gpu': CuRidge(alpha=1.0),
                    'rf_gpu': CuRandomForestRegressor(n_estimators=200, min_samples_leaf=5, n_jobs=-1),
                    'knn_gpu': CuKNeighborsRegressor(n_neighbors=5)
                })
            except Exception as e:
                print(f"GPU models failed to initialize: {e}")
        
        # CPU models (always available as fallback)
        models.update({
            'lasso': Lasso(alpha=0.01, max_iter=10000),
            'enet': ElasticNet(alpha=0.01, l1_ratio=0.5, max_iter=10000),
            'ridge': Ridge(alpha=1.0),
            'rf': RandomForestRegressor(n_estimators=200, min_samples_leaf=5, n_jobs=-1),
            'gbm': GradientBoostingRegressor(n_estimators=100, learning_rate=0.1, max_depth=3),
            'knn': KNeighborsRegressor(n_neighbors=5)
        })
        
        # Add XGBoost with GPU support if available
        if self.use_gpu:
            try:
                models['xgb_gpu'] = xgb.XGBRegressor(
                    n_estimators=500,
                    learning_rate=0.05,
                    max_depth=6,
                    subsample=0.8,
                    colsample_bytree=0.8,
                    tree_method='gpu_hist',
                    gpu_id=0
                )
            except:
                pass
        
        models['xgb'] = xgb.XGBRegressor(
            n_estimators=500,
            learning_rate=0.05,
            max_depth=6,
            subsample=0.8,
            colsample_bytree=0.8,
            n_jobs=-1
        )
        
        return models
    
    def fit_prog(self, train_dat, v=10, learners=None, rng=None):
        """SuperLearner-style model selection via cross-validation."""
        if rng is None:
            rng = np.random.RandomState()
        
        if learners is None:
            learners = self.get_candidate_learners()
        
        # Extract features and target
        X = train_dat.filter(like='W')
        y = train_dat['Y']
        
        # Convert to GPU arrays if using GPU
        if self.use_gpu and any('_gpu' in name for name in learners.keys()):
            try:
                X_gpu = cudf.from_pandas(X)
                y_gpu = cudf.Series(y)
            except:
                X_gpu, y_gpu = X, y
        
        # Setup cross-validation
        cv = KFold(n_splits=v, shuffle=True, random_state=rng.randint(1e9))
        cv_scores = {}
        
        for name, model in learners.items():
            try:
                logger.debug(f"Cross-validating {name}")
                
                # Use GPU data for GPU models
                if self.use_gpu and '_gpu' in name and 'X_gpu' in locals():
                    # For CuML models, we need to handle CV differently
                    scores = []
                    for train_idx, val_idx in cv.split(X):
                        X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]
                        y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]
                        
                        # Convert to CuDF
                        X_train_gpu = cudf.from_pandas(X_train)
                        y_train_gpu = cudf.Series(y_train.values)
                        X_val_gpu = cudf.from_pandas(X_val)
                        y_val_gpu = cudf.Series(y_val.values)
                        
                        model.fit(X_train_gpu, y_train_gpu)
                        pred = model.predict(X_val_gpu)
                        mse = cp.mean((y_val_gpu.values - pred) ** 2)
                        scores.append(-float(mse))  # Negative MSE
                    
                    cv_scores[name] = np.mean(scores)
                else:
                    # Standard CPU cross-validation
                    scores = cross_val_score(
                        model, X, y,
                        scoring='neg_root_mean_squared_error',
                        cv=cv,
                        n_jobs=1  # Already parallel at outer level
                    )
                    cv_scores[name] = scores.mean()
                
                logger.debug(f"{name} CV RMSE: {-cv_scores[name]:.4f}")
                
            except Exception as e:
                logger.error(f"Error in {name} CV: {e}")
                cv_scores[name] = float('-inf')
        
        if not cv_scores:
            raise RuntimeError("All learners failed during cross-validation")
        
        # Find best learner
        best_learner_name = max(cv_scores, key=cv_scores.get)
        best_cv_rmse = -cv_scores[best_learner_name]
        
        logger.info(f"Best learner: {best_learner_name} (CV RMSE: {best_cv_rmse:.4f})")
        
        # Fit best model on all training data
        best_model = learners[best_learner_name]
        
        if self.use_gpu and '_gpu' in best_learner_name:
            try:
                X_gpu = cudf.from_pandas(X)
                y_gpu = cudf.Series(y.values)
                best_model.fit(X_gpu, y_gpu)
            except:
                best_model.fit(X, y)
        else:
            best_model.fit(X, y)
        
        return best_learner_name, best_model, best_cv_rmse

