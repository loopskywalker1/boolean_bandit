# Simple Federated Prometheus Setup for Rancher with Fleet

## Repository Structure in GitLab

```
rancher-prometheus-federation/
├── README.md
├── .gitlab-ci.yml
├── fleet.yaml                    # Fleet configuration
├── values.yaml                   # Default values
├── values-dev.yaml              # Dev environment overrides
├── values-prod.yaml             # Prod environment overrides
└── version.yaml                 # Version management file
```

## Step 1: Create Fleet Configuration

```yaml
# fleet.yaml
defaultNamespace: cattle-monitoring-system

helm:
  repo: https://charts.rancher.io
  chart: rancher-monitoring
  version: 103.0.3+up45.31.1    # This will be managed via version.yaml
  releaseName: rancher-monitoring
  valuesFiles:
    - values.yaml
  
diff:
  comparePatches:
  - apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingWebhookConfiguration
    name: rancher-monitoring-admission
    operations:
    - {"op": "remove", "path": "/webhooks/0/failurePolicy"}
  - apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingWebhookConfiguration 
    name: rancher-monitoring-admission
    operations:
    - {"op": "remove", "path": "/webhooks/0/failurePolicy"}

targetCustomizations:
- name: dev
  clusterSelector:
    matchLabels:
      environment: dev
  helm:
    valuesFiles:
    - values.yaml
    - values-dev.yaml

- name: prod
  clusterSelector:
    matchLabels:
      environment: prod
  helm:
    valuesFiles:
    - values.yaml
    - values-prod.yaml
```

## Step 2: Create Base Values File

```yaml
# values.yaml
# Rancher Monitoring - Prometheus Federation Configuration

prometheus:
  prometheusSpec:
    # Enable federation
    enableFeatures:
      - remote-write-receiver
      - federation
    
    # Retention settings
    retention: 30d
    retentionSize: "200GB"
    
    # Resources
    resources:
      requests:
        cpu: 2000m
        memory: 4Gi
      limits:
        cpu: 4000m
        memory: 8Gi
    
    # Storage with Longhorn
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 300Gi
    
    # Service configuration for federation
    service:
      type: NodePort
      nodePort: 30090
    
    # External labels to identify this Prometheus
    externalLabels:
      cluster: "management"
      prometheus: "rancher-monitoring"
    
    # Scrape configs for federation
    additionalScrapeConfigs:
      # Federate from cluster Prometheus instances
      - job_name: 'federate-clusters'
        scrape_interval: 30s
        honor_labels: true
        metrics_path: '/federate'
        params:
          'match[]':
            - '{job=~".+"}'  # Adjust this to be more selective
        static_configs:
          - targets: []  # Will be populated per environment

grafana:
  enabled: true
  
  # Admin credentials - use a secret in production
  adminPassword: "changeme"
  
  # Persistence
  persistence:
    enabled: true
    storageClassName: longhorn
    size: 20Gi
  
  # Service
  service:
    type: NodePort
    nodePort: 30080
  
  # Default dashboards
  defaultDashboardsEnabled: true
  
  # Sidecar for loading dashboards
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
    datasources:
      enabled: true
      label: grafana_datasource
      labelValue: "1"

alertmanager:
  enabled: true
  alertmanagerSpec:
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi
  
  service:
    type: NodePort
    nodePort: 30093

# Disable components we don't need for simplicity
kubeStateMetrics:
  enabled: true

nodeExporter:
  enabled: true

prometheusOperator:
  enabled: true
  manageCrds: true

# Disable these for now to keep it simple
pushgateway:
  enabled: false

ingressNginx:
  enabled: false

rancherMonitoring:
  enabled: true
```

## Step 3: Environment-Specific Values

```yaml
# values-dev.yaml
prometheus:
  prometheusSpec:
    replicas: 1
    retention: 7d
    retentionSize: "50GB"
    
    resources:
      requests:
        cpu: 500m
        memory: 1Gi
      limits:
        cpu: 1000m
        memory: 2Gi
    
    storageSpec:
      volumeClaimTemplate:
        spec:
          resources:
            requests:
              storage: 100Gi
    
    # Dev cluster federation targets
    additionalScrapeConfigs:
      - job_name: 'federate-dev-clusters'
        scrape_interval: 30s
        honor_labels: true
        metrics_path: '/federate'
        params:
          'match[]':
            - '{__name__=~"node_.*"}'
            - '{__name__=~"kube_.*"}'
            - '{__name__=~"container_.*"}'
        static_configs:
          - targets:
            - 'dev-cluster-1.local:30090'
            - 'dev-cluster-2.local:30090'

grafana:
  adminPassword: "devpassword"  # Change this!
```

```yaml
# values-prod.yaml
prometheus:
  prometheusSpec:
    replicas: 2
    retention: 30d
    retentionSize: "500GB"
    
    # HA configuration
    replicaExternalLabelName: "prometheus_replica"
    prometheusExternalLabelName: "prometheus"
    
    # Production federation targets
    additionalScrapeConfigs:
      - job_name: 'federate-prod-clusters'
        scrape_interval: 30s
        honor_labels: true
        metrics_path: '/federate'
        params:
          'match[]':
            - '{__name__=~"node_.*"}'
            - '{__name__=~"kube_.*"}'
            - '{__name__=~"container_.*"}'
            - '{__name__=~"up"}'
        static_configs:
          - targets:
            - 'prod-cluster-1.local:30090'
            - 'prod-cluster-2.local:30090'
            - 'prod-cluster-3.local:30090'

grafana:
  adminPassword: "prodpassword"  # Use a secret!
  
  # Additional production settings
  ingress:
    enabled: false  # Using NodePort as specified
```

