#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Refactored Python implementation of the R simulation driver script.

This script performs a Monte Carlo simulation study:
1. Generates historical data based on a specified DGP
2. Trains a prognostic model using cross-validation
3. Benchmarks estimators across different trial sizes
4. Runs multiple Monte Carlo repetitions in parallel
5. Saves results to Parquet files in a timestamped directory

Python 3.6+ compatible.
"""

import os
import time
import datetime
from pathlib import Path
import multiprocessing as mp
from concurrent.futures import ProcessPoolExecutor, as_completed
import logging
from itertools import product
import numpy as np
import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from sklearn.model_selection import KFold, cross_val_score
from sklearn.metrics import mean_squared_error
from sklearn.linear_model import Lasso, ElasticNet, Ridge
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from xgboost import XGBRegressor
from tqdm.auto import tqdm

# ===============================================================
# --- Logging Setup ---
# ===============================================================

# Generate a timestamp for the current run
run_timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
log_filename = f"simulation_{run_timestamp}.log"

# Set up logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(name)s - %(message)s',
    handlers=[
        logging.FileHandler(log_filename),
        logging.StreamHandler()
    ]
)

logger = logging.getLogger(__name__)
logger.info(f"Starting new simulation run at {run_timestamp}")

# ===============================================================
# --- Global Config ---
# ===============================================================

# Simulation parameters
DGP_STRING = "dgp3"
N_HIST = 2000
Y_NOISE = 6
CV_FOLDS = 10
PARAM_GRID = {"n_trials": range(100, 501, 50)}  # 100, 150, ..., 500
N_RUNS = 200
N_WORKERS = min(mp.cpu_count(), 32)
USE_GPU = True  # Set to False if no GPU is available

# Random seeds for reproducibility
BASE_SEED = 129483
EXPERIMENT_SEED = 3021377

# Output paths - use timestamp for unique folder
unique_run_name = f"run_{run_timestamp}"
BASE_DIR = Path("results") / DGP_STRING / unique_run_name
EXP_DIR = BASE_DIR / "experiments"
EXP_DIR.mkdir(parents=True, exist_ok=True)

logger.info(f"Output directory created: {BASE_DIR}")

# Create a random number generator for the main process
MAIN_RNG = np.random.RandomState(BASE_SEED)

# ===============================================================
# --- Data Generation Functions ---
# ===============================================================

def set_dgp(dgp_string):
    """
    Define data generating processes for different scenarios.
    
    Args:
        dgp_string: Identifier for which DGP to use
        
    Returns:
        Tuple of (mu0, mu1) functions that generate potential outcomes
    """
    def mu0_constant(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10) - 3

    def mu1_constant(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)

    def mu0_heterogeneous(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)**2 - 30.00103

    def mu1_heterogeneous(X):
        return np.sin(np.abs(X[:, 0])*np.pi/10)

    def mu0_dgp3(X):
        return (X[:, 0]**2 + 
                2.4 * X[:, 2] + 
                X[:, 4] - 
                np.sqrt(np.abs(X[:, 0])))

    def mu1_dgp3(X):
        return (X[:, 0]**2 + 
                2*X[:, 1] - 
                0.2 * X[:, 2] + 
                X[:, 4] - 
                np.sqrt(np.abs(X[:, 0])))

    dgp_functions = {
        'constant': (mu0_constant, mu1_constant),
        'heterogeneous': (mu0_heterogeneous, mu1_heterogeneous),
        'dgp3': (mu0_dgp3, mu1_dgp3)
    }
    
    return dgp_functions.get(dgp_string, dgp_functions['dgp3'])

def dgp(n, y_noise=0, dgp_string="dgp3", rng=None):
    """
    Generate synthetic data based on the specified DGP.
    
    Args:
        n: Number of samples to generate
        y_noise: Standard deviation of noise to add
        dgp_string: Which DGP to use
        rng: Random number generator (if None, use global RNG)
        
    Returns:
        DataFrame with covariates W1-W5, treatment A, potential outcomes Y0/Y1, and observed Y
    """
    if rng is None:
        rng = MAIN_RNG
        
    # Generate covariates (features) uniformly between -1 and 1
    X = rng.uniform(-1, 1, size=(n, 5))
    
    # Get DGP functions for generating potential outcomes
    mu0_func, mu1_func = set_dgp(dgp_string)
    
    # Generate potential outcomes with noise
    Y0 = mu0_func(X) + rng.normal(0, y_noise, n)
    Y1 = mu1_func(X) + rng.normal(0, y_noise, n)
    
    # Randomly assign treatment with 50% probability
    A = rng.binomial(1, 0.5, n)
    
    # Observed outcome depends on treatment assignment
    Y = A * Y1 + (1 - A) * Y0
    
    # Create DataFrame with all variables
    data = pd.DataFrame({
        'W1': X[:, 0], 'W2': X[:, 1], 'W3': X[:, 2], 'W4': X[:, 3], 'W5': X[:, 4],
        'A': A, 'Y': Y, 'Y0': Y0, 'Y1': Y1
    })
    
    return data

def get_hist_dat(n_hist, y_noise=6, dgp_string="dgp3", rng=None):
    """
    Generate historical data and split into training/test sets.
    Similar to R's get_hist_dat function.
    
    Args:
        n_hist: Total number of historical samples
        y_noise: Noise level
        dgp_string: Which DGP to use
        rng: Random number generator
        
    Returns:
        Tuple of (train_df, test_df)
    """
    if rng is None:
        rng = MAIN_RNG
        
    # Generate data
    data = dgp(n=n_hist, y_noise=y_noise, dgp_string=dgp_string, rng=rng)
    
    # Split 70/30 like R's initial_split
    train_indices = rng.choice(n_hist, size=int(0.7 * n_hist), replace=False)
    train_df = data.iloc[train_indices].reset_index(drop=True)
    test_df = data.drop(train_indices).reset_index(drop=True)
    
    logger.debug(f"Historical data split: {train_df.shape[0]} train, {test_df.shape[0]} test")
    
    return train_df, test_df

# ===============================================================
# --- Prognostic Model Selection and Training ---
# ===============================================================

def get_candidate_learners():
    """
    Define a set of candidate models for SuperLearner-style selection.
    
    Returns:
        Dictionary of initialized model objects
    """
    models = {
        "lasso": Lasso(alpha=0.01, max_iter=10000, random_state=MAIN_RNG.randint(1e9)),
        "enet": ElasticNet(alpha=0.01, l1_ratio=0.5, max_iter=10000, random_state=MAIN_RNG.randint(1e9)),
        "ridge": Ridge(alpha=1.0, random_state=MAIN_RNG.randint(1e9)),
        "rf": RandomForestRegressor(
            n_estimators=200, 
            min_samples_leaf=5,
            n_jobs=-1,
            random_state=MAIN_RNG.randint(1e9)
        ),
        "gbm": GradientBoostingRegressor(
            n_estimators=100,
            learning_rate=0.1,
            max_depth=3,
            random_state=MAIN_RNG.randint(1e9)
        )
    }
    
    # Add XGBoost GPU model if GPU usage is enabled
    if USE_GPU:
        try:
            # Try to initialize XGBoost with GPU
            models["xgb_gpu"] = XGBRegressor(
                n_estimators=500,
                learning_rate=0.05,
                max_depth=6,
                subsample=0.8,
                colsample_bytree=0.8,
                tree_method="gpu_hist",
                random_state=MAIN_RNG.randint(1e9)
            )
            logger.info("Added XGBoost GPU model to candidate learners")
        except Exception as e:
            logger.warning(f"Could not initialize XGBoost GPU model: {e}")
            # Fallback to CPU XGBoost
            models["xgb"] = XGBRegressor(
                n_estimators=500,
                learning_rate=0.05,
                max_depth=6,
                subsample=0.8,
                colsample_bytree=0.8,
                tree_method="hist",
                n_jobs=-1,
                random_state=MAIN_RNG.randint(1e9)
            )
            logger.info("Added XGBoost CPU model to candidate learners")
    else:
        # CPU-only XGBoost
        models["xgb"] = XGBRegressor(
            n_estimators=500,
            learning_rate=0.05,
            max_depth=6,
            subsample=0.8,
            colsample_bytree=0.8,
            tree_method="hist",
            n_jobs=-1,
            random_state=MAIN_RNG.randint(1e9)
        )
        logger.info("Added XGBoost CPU model to candidate learners")
    
    return models

def fit_prog(train_dat, v=10, learners=None, rng=None):
    """
    SuperLearner-style model selection via cross-validation.
    Equivalent to R's fit_prog function.
    
    Args:
        train_dat: Training data DataFrame
        v: Number of CV folds
        learners: Dictionary of candidate models (if None, uses default)
        rng: Random number generator
        
    Returns:
        Tuple of (best_learner_name, fitted_model, best_cv_rmse)
    """
    if rng is None:
        rng = MAIN_RNG
    
    if learners is None:
        learners = get_candidate_learners()
    
    # Extract features and target
    X = train_dat.filter(like='W')
    y = train_dat['Y']
    
    # Setup cross-validation
    cv = KFold(n_splits=v, shuffle=True, random_state=rng.randint(1e9))
    
    # Evaluate each learner
    cv_scores = {}
    for name, model in learners.items():
        logger.debug(f"Cross-validating {name}")
        try:
            # Need to negate since sklearn returns negative RMSE
            scores = -cross_val_score(
                model, X, y, 
                scoring='neg_root_mean_squared_error',
                cv=cv,
                n_jobs=1  # Already parallel at the outer level
            )
            cv_scores[name] = scores.mean()
            logger.debug(f"  {name} CV RMSE: {scores.mean():.4f}")
        except Exception as e:
            logger.error(f"Error in {name} CV: {e}")
            cv_scores[name] = float('inf')
    
    if not cv_scores:
        raise RuntimeError("All learners failed during cross-validation")
    
    # Find best learner
    best_learner_name = min(cv_scores, key=cv_scores.get)
    best_cv_rmse = cv_scores[best_learner_name]
    
    logger.info(f"Best learner: {best_learner_name} (CV RMSE: {best_cv_rmse:.4f})")
    
    # Fit the best model on all training data
    best_model = learners[best_learner_name].fit(X, y)
    
    return best_learner_name, best_model, best_cv_rmse

def calc_kappa(prog_model, test_dat):
    """
    Calculate RMSE on test data using prognostic model.
    Equivalent to R's calc_kappa function.
    
    Args:
        prog_model: Fitted prognostic model
        test_dat: Test data DataFrame
        
    Returns:
        RMSE value
    """
    X_test = test_dat.filter(like='W')
    y_true = test_dat['Y']
    y_pred = prog_model.predict(X_test)
    
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    return rmse

# ===============================================================
# --- Experiment Function ---
# ===============================================================

def experiment(n_trials, prog_model, y_noise, dgp_string, rng=None):
    """
    Run one experiment for a given parameter set.
    Mimics experiment() from experiment.R
    
    Args:
        n_trials: Number of trials to simulate
        prog_model: Fitted prognostic model
        y_noise: Noise level
        dgp_string: Which DGP to use
        rng: Random number generator
        
    Returns:
        Dictionary with experiment results
    """
    if rng is None:
        rng = MAIN_RNG
        
    # Generate a new dataset with n_trials samples
    trial_data = dgp(n=n_trials, y_noise=y_noise, dgp_string=dgp_string, rng=rng)
    
    # Extract features for prediction
    X_trial = trial_data.filter(like='W')
    y_true = trial_data['Y']
    
    # Predict with prognostic model
    y_pred = prog_model.predict(X_trial)
    
    # Calculate performance metrics
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    bias = np.mean(y_pred - y_true)
    var_pred = np.var(y_pred)
    
    # Calculate true and estimated treatment effects
    true_ate = trial_data['Y1'].mean() - trial_data['Y0'].mean()
    
    # Simple difference in means estimator
    treated_mean = trial_data.loc[trial_data['A'] == 1, 'Y'].mean()
    control_mean = trial_data.loc[trial_data['A'] == 0, 'Y'].mean()
    naive_ate = treated_mean - control_mean
    
    return {
        'n_trials': n_trials,
        'rmse': rmse,
        'bias': bias,
        'var_pred': var_pred,
        'true_ate': true_ate,
        'naive_ate': naive_ate
    }

# ===============================================================
# --- Monte Carlo Run Function ---
# ===============================================================

def run_experiment(run_index):
    """
    Run a full Monte Carlo repetition across parameter grid.
    Equivalent to R's run_experiment function.
    
    Args:
        run_index: Index of this Monte Carlo run
        
    Returns:
        Name of the output file created
    """
    worker_id = os.getpid()
    logger.info(f"Worker {worker_id} starting run {run_index}")
    
    # Create worker-specific RNG with unique seed derived from experimental_seed
    # This ensures reproducibility while allowing parallelism
    run_rng = np.random.RandomState(EXPERIMENT_SEED + run_index)
    
    try:
        # Loop through all parameter combinations
        results = []
        for n_trials in PARAM_GRID['n_trials']:
            # Call experiment with this parameter setting
            result = experiment(
                n_trials=n_trials,
                prog_model=prog_model,  # Using the global prog_model
                y_noise=Y_NOISE,
                dgp_string=DGP_STRING,
                rng=run_rng
            )
            
            # Add run index and seed for traceability
            result['run'] = run_index
            result['seed'] = EXPERIMENT_SEED
            
            results.append(result)
        
        # Combine all parameter results into a DataFrame
        result_df = pd.DataFrame(results)
        
        # Create output filename like in R
        output_filename = f"experiment_result_run_{run_index}.parquet"
        output_path = EXP_DIR / output_filename
        
        # Write to parquet file
        table = pa.Table.from_pandas(result_df)
        pq.write_table(table, output_path)
        
        logger.info(f"Worker {worker_id} completed run {run_index}")
        return output_filename
        
    except Exception as e:
        logger.error(f"Worker {worker_id} error in run {run_index}: {str(e)}", exc_info=True)
        return None

# ===============================================================
# --- Main Function ---
# ===============================================================

def main():
    global prog_model, sig3, best_learner_name, kappa3
    
    logger.info(f"Starting simulation with {N_RUNS} runs on {N_WORKERS} workers")
    logger.info(f"DGP: {DGP_STRING}, Noise: {Y_NOISE}, CV Folds: {CV_FOLDS}")
    
    # Generate historical data
    logger.info(f"Generating historical data (n={N_HIST})...")
    hist_train, hist_test = get_hist_dat(
        n_hist=N_HIST, 
        y_noise=Y_NOISE, 
        dgp_string=DGP_STRING
    )
    
    # Fit prognostic model on historical data
    logger.info("Fitting prognostic model...")
    best_learner_name, prog_model, cv_rmse = fit_prog(
        train_dat=hist_train,
        v=CV_FOLDS
    )
    
    # Calculate kappa on test set
    kappa3 = calc_kappa(prog_model, hist_test)
    logger.info(f"Prognostic model performance (kappa3): {kappa3:.4f}")
    
    # Calculate sig3 (SD of outcome)
    sig3 = np.std(
        np.concatenate([hist_train['Y'].values, hist_test['Y'].values]), 
        ddof=1  # Use n-1 denominator like R's sd()
    )
    logger.info(f"Outcome standard deviation (sig3): {sig3:.4f}")
    
    # Run experiments in parallel
    logger.info(f"Running {N_RUNS} Monte Carlo repetitions...")
    start_time = time.time()
    
    with ProcessPoolExecutor(max_workers=N_WORKERS) as executor:
        futures = [executor.submit(run_experiment, i) for i in range(1, N_RUNS + 1)]
        
        # Track progress
        completed = 0
        failed = 0
        
        for future in tqdm(as_completed(futures), total=N_RUNS, desc="MC Runs"):
            try:
                result = future.result()
                if result:
                    completed += 1
                else:
                    failed += 1
            except Exception as e:
                logger.error(f"Error in future: {str(e)}")
                failed += 1
    
    duration = time.time() - start_time
    logger.info(f"Completed {completed} runs, failed {failed} runs in {duration:.1f} seconds")
    
    # Create summary file like in R
    logger.info("Creating metadata file...")
    summary_df = pd.DataFrame({
        'best_learner_name': [best_learner_name],
        'kappa3': [kappa3],
        'sig3': [sig3],
        'dgp_string': [DGP_STRING],
        'n_hist': [N_HIST],
        'y_noise': [Y_NOISE],
        'cv_folds': [CV_FOLDS],
        'timestamp': [run_timestamp],
        'completed_runs': [completed]
    })
    
    # Write summary file
    summary_path = BASE_DIR / f"run_metadata_{DGP_STRING}.parquet"
    summary_table = pa.Table.from_pandas(summary_df)
    pq.write_table(summary_table, summary_path)
    
    logger.info(f"Metadata saved to {summary_path}")
    logger.info(f"Finished simulation run {run_timestamp}")

if __name__ == "__main__":
    main()
