# Fleet configuration for dords Helm chart - Development
defaultNamespace: core

# Target only dev cluster
targets:
- name: dev
  clusterSelector:
    matchLabels:
      env: dev

# Helm configuration for dev
helm:
  # Chart path - go up two directories then into dords folder
  chart: "../../dords"
  
  # Release name
  releaseName: dords
  
  # Values file for dev (relative to the chart root)
  valuesFiles:
  - values-dev.yaml
  
  # Development-specific settings
  force: false
  maxHistory: 3
  timeout: 5m
  wait: true
  atomic: true

# Faster polling for dev
pollingInterval: 10s

# Less restrictive rollout for dev
rolloutStrategy:
  autoPartitionSize: 100%
  maxUnavailable: 1

