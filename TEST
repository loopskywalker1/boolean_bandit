class ModelSelector:
    """Python equivalent of R's model selection and CV functions"""
    
    def __init__(self):
        self.default_learners = self._get_default_learners()
        
    def _get_default_learners(self):
        """
        Python equivalent of R's default_learners list
        Based on the learners shown in Images 3-4
        """
        return {
            'knn': KNeighborsRegressor(n_neighbors=5),
            'linear': LinearRegression(),
            'gbt': GradientBoostingRegressor(n_estimators=100, random_state=42),
            'rf': RandomForestRegressor(n_estimators=100, random_state=42),
            'ridge': Ridge(alpha=1.0),
            'lasso': Lasso(alpha=0.1)
        }
    
    def get_best_learner(self, train_data, target_col='y', cv_folds=5, verbose=True):
        """
        Python equivalent of R's get_best_learner function
        Performs cross-validation and selects best model
        """
        # Prepare features and target
        feature_cols = [col for col in train_data.columns if col not in [target_col, 'y0', 'y1']]
        X = train_data[feature_cols]
        y = train_data[target_col]
        
        # Set up cross-validation (equivalent to R's vfold_cv)
        cv = KFold(n_splits=cv_folds, shuffle=True, random_state=42)
        
        best_score = float('inf')
        best_learner = None
        best_learner_name = None
        
        if verbose:
            print(f"Evaluating {len(self.default_learners)} learners with {cv_folds}-fold CV...")
        
        # Evaluate each learner (equivalent to R's workflow_map)
        for name, learner in self.default_learners.items():
            try:
                # Cross-validation with RMSE scoring
                cv_scores = cross_val_score(
                    learner, X, y, cv=cv, scoring='neg_mean_squared_error', n_jobs=-1
                )
                rmse_scores = np.sqrt(-cv_scores)  # Convert to RMSE
                mean_rmse = np.mean(rmse_scores)
                
                if verbose:
                    print(f"{name}: RMSE = {mean_rmse:.4f} (+/- {np.std(rmse_scores):.4f})")
                
                if mean_rmse < best_score:
                    best_score = mean_rmse
                    best_learner = learner
                    best_learner_name = name
                    
            except Exception as e:
                if verbose:
                    print(f"Error with {name}: {e}")
                continue
        
        # Fit best learner on full training data
        best_learner.fit(X, y)
        
        return {
            'model': best_learner,
            'name': best_learner_name,
            'rmse': best_score,
            'feature_cols': feature_cols
        }

