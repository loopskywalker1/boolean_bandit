#!/usr/bin/env python3
"""
Simplified GPU-Optimized Causal Inference Monte Carlo Simulation
=================================================================
This code performs Monte Carlo simulations for causal inference experiments
with support for GPU acceleration on NVIDIA A100 or similar GPUs.

Key Features:
- Generates synthetic data with known treatment effects
- Trains multiple ML models using cross-validation
- Runs parallel Monte Carlo experiments
- Supports both CPU and GPU execution
- Saves results in Parquet format for analysis
"""

import os
import numpy as np
import pandas as pd
import time
import logging
from pathlib import Path
from concurrent.futures import ProcessPoolExecutor, as_completed
import warnings
warnings.filterwarnings('ignore')

# ===== GPU SUPPORT (OPTIONAL) =====
# Try to import GPU libraries - if not available, fall back to CPU
try:
    import cupy as cp
    import cudf
    from cuml.ensemble import RandomForestRegressor as CuRandomForestRegressor
    from cuml.linear_model import Ridge as CuRidge, Lasso as CuLasso
    from cuml.neighbors import KNeighborsRegressor as CuKNeighborsRegressor
    GPU_AVAILABLE = True
    print("✓ GPU libraries loaded - will use GPU acceleration")
except ImportError:
    GPU_AVAILABLE = False
    print("✗ GPU libraries not available - will use CPU only")

# ===== STANDARD ML LIBRARIES =====
from sklearn.model_selection import KFold, cross_val_score
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.linear_model import Ridge, Lasso, ElasticNet
from sklearn.neighbors import KNeighborsRegressor
from sklearn.metrics import mean_squared_error
import pyarrow.parquet as pq
import pyarrow as pa
from tqdm import tqdm

# ===== LOGGING SETUP =====
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)


class DataGenerator:
    """
    Generates synthetic data for causal inference experiments.
    
    This class creates datasets with:
    - 6 covariates (W1-W6) drawn from uniform[-1, 1]
    - Binary treatment assignment (A) with 50% probability
    - Potential outcomes (Y0, Y1) based on covariates
    - Observed outcome (Y) based on treatment assignment
    """
    
    def __init__(self, use_gpu=True):
        """
        Initialize data generator.
        
        Args:
            use_gpu: Whether to use GPU acceleration if available
        """
        self.use_gpu = use_gpu and GPU_AVAILABLE
        # Use CuPy (GPU) or NumPy (CPU) based on availability
        self.xp = cp if self.use_gpu else np
        
    def generate_data(self, n, y_noise=6, dgp_type="dgp3", seed=None):
        """
        Generate synthetic causal inference data.
        
        Args:
            n: Number of observations to generate
            y_noise: Standard deviation of outcome noise
            dgp_type: Data generating process type ("constant", "heterogeneous", "dgp3")
            seed: Random seed for reproducibility
            
        Returns:
            DataFrame with columns: W1-W6, A, Y, Y0, Y1
        """
        # Set random seed if provided
        if seed is not None:
            if self.use_gpu:
                cp.random.seed(seed)
            else:
                np.random.seed(seed)
        
        # Generate 6 covariates uniformly between -1 and 1
        if self.use_gpu:
            X = cp.random.uniform(-1, 1, size=(n, 6))
        else:
            X = np.random.uniform(-1, 1, size=(n, 6))
        
        # Calculate potential outcomes based on DGP type
        Y0, Y1 = self._calculate_potential_outcomes(X, dgp_type)
        
        # Add noise to potential outcomes
        if self.use_gpu:
            Y0 += cp.random.normal(0, y_noise, n)
            Y1 += cp.random.normal(0, y_noise, n)
        else:
            Y0 += np.random.normal(0, y_noise, n)
            Y1 += np.random.normal(0, y_noise, n)
        
        # Randomly assign treatment with 50% probability
        if self.use_gpu:
            A = cp.random.binomial(1, 0.5, n)
        else:
            A = np.random.binomial(1, 0.5, n)
        
        # Observed outcome depends on treatment
        # Y = Y1 if treated (A=1), Y0 if control (A=0)
        Y = A * Y1 + (1 - A) * Y0
        
        # Convert GPU arrays to CPU for DataFrame creation
        if self.use_gpu:
            X = cp.asnumpy(X)
            Y = cp.asnumpy(Y)
            Y0 = cp.asnumpy(Y0)
            Y1 = cp.asnumpy(Y1)
            A = cp.asnumpy(A)
        
        # Create DataFrame with all variables
        data = pd.DataFrame({
            'W1': X[:, 0], 'W2': X[:, 1], 'W3': X[:, 2],
            'W4': X[:, 3], 'W5': X[:, 4], 'W6': X[:, 5],
            'A': A, 'Y': Y, 'Y0': Y0, 'Y1': Y1
        })
        
        return data
    
    def _calculate_potential_outcomes(self, X, dgp_type):
        """
        Calculate potential outcomes Y0 and Y1 based on covariates.
        
        Different DGP types create different relationships between
        covariates and potential outcomes, allowing us to test
        estimator performance under various scenarios.
        """
        if dgp_type == "constant":
            # Constant treatment effect
            Y0 = self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10 - 3
            Y1 = self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10
            
        elif dgp_type == "heterogeneous":
            # Heterogeneous treatment effect
            Y0 = self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10 ** 2 - 30.00103
            Y1 = self.xp.sin(self.xp.abs(X[:, 0])) * self.xp.pi/10
            
        else:  # dgp3 (default)
            # Complex non-linear relationships
            Y0 = (X[:, 0]**2 + 
                  2.4 * X[:, 2] + 
                  X[:, 4] + 
                  0.5 * X[:, 5] - 
                  self.xp.sqrt(self.xp.abs(X[:, 0])))
            
            Y1 = (X[:, 0]**2 + 
                  2 * X[:, 1] - 
                  0.2 * X[:, 2] + 
                  X[:, 4] + 
                  0.5 * X[:, 5] - 
                  self.xp.sqrt(self.xp.abs(X[:, 0])))
        
        return Y0, Y1


class ModelSelector:
    """
    Selects best predictive model using cross-validation.
    
    This class implements a simplified Super Learner approach:
    1. Trains multiple candidate models
    2. Evaluates each using k-fold cross-validation
    3. Selects the model with lowest RMSE
    """
    
    def __init__(self, use_gpu=True):
        """Initialize model selector with GPU support if available."""
        self.use_gpu = use_gpu and GPU_AVAILABLE
        
    def get_candidate_models(self):
        """
        Get dictionary of candidate models.
        
        Returns both GPU and CPU versions when GPU is available,
        otherwise just CPU versions.
        """
        models = {}
        
        # GPU models (if available)
        if self.use_gpu:
            try:
                models.update({
                    'ridge_gpu': CuRidge(alpha=1.0),
                    'lasso_gpu': CuLasso(alpha=0.01),
                    'rf_gpu': CuRandomForestRegressor(
                        n_estimators=100,
                        max_depth=10,
                        random_state=42
                    ),
                    'knn_gpu': CuKNeighborsRegressor(n_neighbors=10)
                })
                logger.info("Added GPU models to candidate set")
            except Exception as e:
                logger.warning(f"Could not initialize GPU models: {e}")
        
        # CPU models (always available)
        models.update({
            'ridge': Ridge(alpha=1.0),
            'lasso': Lasso(alpha=0.01, max_iter=5000),
            'elastic': ElasticNet(alpha=0.01, l1_ratio=0.5, max_iter=5000),
            'rf': RandomForestRegressor(
                n_estimators=100,
                max_depth=10,
                min_samples_leaf=5,
                random_state=42,
                n_jobs=-1
            ),
            'gbm': GradientBoostingRegressor(
                n_estimators=100,
                learning_rate=0.1,
                max_depth=5,
                random_state=42
            ),
            'knn': KNeighborsRegressor(n_neighbors=10)
        })
        
        return models
    
    def select_best_model(self, train_data, cv_folds=10):
        """
        Select best model using cross-validation.
        
        Args:
            train_data: Training DataFrame with features W1-W6 and outcome Y
            cv_folds: Number of cross-validation folds
            
        Returns:
            Tuple of (model_name, fitted_model, cv_rmse)
        """
        # Extract features and outcome
        X = train_data[['W1', 'W2', 'W3', 'W4', 'W5', 'W6']]
        y = train_data['Y']
        
        # Get candidate models
        models = self.get_candidate_models()
        
        # Evaluate each model using cross-validation
        cv_results = {}
        kf = KFold(n_splits=cv_folds, shuffle=True, random_state=42)
        
        logger.info(f"Evaluating {len(models)} models with {cv_folds}-fold CV...")
        
        for name, model in models.items():
            try:
                # Handle GPU models differently
                if self.use_gpu and '_gpu' in name:
                    # Manual CV for GPU models
                    scores = []
                    for train_idx, val_idx in kf.split(X):
                        # Split data
                        X_train = X.iloc[train_idx]
                        X_val = X.iloc[val_idx]
                        y_train = y.iloc[train_idx]
                        y_val = y.iloc[val_idx]
                        
                        # Convert to GPU format
                        X_train_gpu = cudf.from_pandas(X_train)
                        y_train_gpu = cudf.Series(y_train.values)
                        X_val_gpu = cudf.from_pandas(X_val)
                        
                        # Fit and predict
                        model.fit(X_train_gpu, y_train_gpu)
                        y_pred = model.predict(X_val_gpu)
                        
                        # Calculate RMSE
                        if hasattr(y_pred, 'values'):
                            y_pred = y_pred.values
                        mse = np.mean((y_val.values - cp.asnumpy(y_pred))**2)
                        scores.append(np.sqrt(mse))
                    
                    cv_rmse = np.mean(scores)
                    
                else:
                    # Standard sklearn cross-validation for CPU models
                    scores = cross_val_score(
                        model, X, y,
                        cv=kf,
                        scoring='neg_root_mean_squared_error',
                        n_jobs=1
                    )
                    cv_rmse = -scores.mean()
                
                cv_results[name] = cv_rmse
                logger.debug(f"{name}: CV RMSE = {cv_rmse:.4f}")
                
            except Exception as e:
                logger.error(f"Error evaluating {name}: {e}")
                cv_results[name] = float('inf')
        
        # Select best model (lowest RMSE)
        best_name = min(cv_results, key=cv_results.get)
        best_rmse = cv_results[best_name]
        
        logger.info(f"Best model: {best_name} (CV RMSE: {best_rmse:.4f})")
        
        # Refit best model on all training data
        best_model = models[best_name]
        if self.use_gpu and '_gpu' in best_name:
            X_gpu = cudf.from_pandas(X)
            y_gpu = cudf.Series(y.values)
            best_model.fit(X_gpu, y_gpu)
        else:
            best_model.fit(X, y)
        
        return best_name, best_model, best_rmse


def run_single_experiment(params):
    """
    Run a single experiment iteration.
    
    This function:
    1. Generates new trial data
    2. Makes predictions using the trained model
    3. Calculates performance metrics
    4. Returns results dictionary
    """
    # Unpack parameters
    n_trials = params['n_trials']
    model_info = params['model_info']
    y_noise = params['y_noise']
    dgp_type = params['dgp_type']
    iteration = params['iteration']
    seed = params['seed']
    
    # Set seed for this iteration
    iter_seed = seed + iteration if seed else None
    
    # Generate trial data
    data_gen = DataGenerator(use_gpu=GPU_AVAILABLE)
    trial_data = data_gen.generate_data(
        n=n_trials,
        y_noise=y_noise,
        dgp_type=dgp_type,
        seed=iter_seed
    )
    
    # Extract model components
    model_name, fitted_model, cv_rmse = model_info
    
    # Make predictions
    X_trial = trial_data[['W1', 'W2', 'W3', 'W4', 'W5', 'W6']]
    
    try:
        if GPU_AVAILABLE and '_gpu' in model_name:
            X_trial_gpu = cudf.from_pandas(X_trial)
            y_pred = fitted_model.predict(X_trial_gpu)
            if hasattr(y_pred, 'values'):
                y_pred = cp.asnumpy(y_pred.values)
            else:
                y_pred = cp.asnumpy(y_pred)
        else:
            y_pred = fitted_model.predict(X_trial)
    except Exception as e:
        logger.error(f"Prediction failed: {e}")
        y_pred = np.zeros(len(X_trial))
    
    # Calculate metrics
    y_true = trial_data['Y']
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    
    # Calculate treatment effects
    true_ate = trial_data['Y1'].mean() - trial_data['Y0'].mean()
    
    # Simple difference in means estimator
    treated_outcomes = trial_data.loc[trial_data['A'] == 1, 'Y']
    control_outcomes = trial_data.loc[trial_data['A'] == 0, 'Y']
    estimated_ate = treated_outcomes.mean() - control_outcomes.mean()
    
    # Return results
    return {
        'iteration': iteration,
        'n_trials': n_trials,
        'model': model_name,
        'cv_rmse': cv_rmse,
        'test_rmse': rmse,
        'true_ate': true_ate,
        'estimated_ate': estimated_ate,
        'ate_bias': estimated_ate - true_ate,
        'n_treated': len(treated_outcomes),
        'n_control': len(control_outcomes)
    }


def main():
    """
    Main function to orchestrate the Monte Carlo simulation.
    
    This function:
    1. Sets up the experiment parameters
    2. Generates historical data for model training
    3. Selects the best predictive model
    4. Runs multiple experiment iterations in parallel
    5. Saves results to disk
    """
    
    # ===== EXPERIMENT CONFIGURATION =====
    # These parameters control the simulation
    CONFIG = {
        'dgp_type': 'dgp3',           # Data generating process
        'n_hist': 2000,               # Historical data size for training
        'y_noise': 6,                 # Outcome noise level
        'cv_folds': 10,               # Cross-validation folds
        'n_iterations': 200,          # Number of MC iterations
        'n_trials_list': [100, 200, 300, 400, 500],  # Sample sizes to test
        'n_workers': min(8, os.cpu_count()),  # Parallel workers
        'seed': 42                    # Random seed
    }
    
    # Create output directory
    output_dir = Path('results') / CONFIG['dgp_type']
    output_dir.mkdir(parents=True, exist_ok=True)
    
    logger.info("="*60)
    logger.info("CAUSAL INFERENCE MONTE CARLO SIMULATION")
    logger.info("="*60)
    logger.info(f"Configuration: {CONFIG}")
    
    # ===== STEP 1: GENERATE HISTORICAL DATA =====
    logger.info("\nStep 1: Generating historical data...")
    data_gen = DataGenerator(use_gpu=GPU_AVAILABLE)
    hist_data = data_gen.generate_data(
        n=CONFIG['n_hist'],
        y_noise=CONFIG['y_noise'],
        dgp_type=CONFIG['dgp_type'],
        seed=CONFIG['seed']
    )
    
    # Split into train/test (70/30)
    train_size = int(0.7 * len(hist_data))
    train_indices = np.random.RandomState(CONFIG['seed']).choice(
        len(hist_data), size=train_size, replace=False
    )
    
    train_data = hist_data.iloc[train_indices]
    test_data = hist_data.drop(train_indices)
    
    logger.info(f"Training data: {len(train_data)} observations")
    logger.info(f"Test data: {len(test_data)} observations")
    
    # ===== STEP 2: SELECT BEST MODEL =====
    logger.info("\nStep 2: Selecting best model...")
    model_selector = ModelSelector(use_gpu=GPU_AVAILABLE)
    model_info = model_selector.select_best_model(
        train_data,
        cv_folds=CONFIG['cv_folds']
    )
    
    # Evaluate on test set
    X_test = test_data[['W1', 'W2', 'W3', 'W4', 'W5', 'W6']]
    y_test = test_data['Y']
    
    model_name, fitted_model, _ = model_info
    if GPU_AVAILABLE and '_gpu' in model_name:
        X_test_gpu = cudf.from_pandas(X_test)
        y_pred = fitted_model.predict(X_test_gpu)
        y_pred = cp.asnumpy(y_pred.values) if hasattr(y_pred, 'values') else cp.asnumpy(y_pred)
    else:
        y_pred = fitted_model.predict(X_test)
    
    test_rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    logger.info(f"Test set RMSE: {test_rmse:.4f}")
    
    # ===== STEP 3: RUN MONTE CARLO EXPERIMENTS =====
    logger.info("\nStep 3: Running Monte Carlo experiments...")
    
    # Create parameter combinations
    all_params = []
    for n_trials in CONFIG['n_trials_list']:
        for i in range(CONFIG['n_iterations']):
            all_params.append({
                'n_trials': n_trials,
                'model_info': model_info,
                'y_noise': CONFIG['y_noise'],
                'dgp_type': CONFIG['dgp_type'],
                'iteration': i,
                'seed': CONFIG['seed']
            })
    
    logger.info(f"Total experiments: {len(all_params)}")
    
    # Run experiments in parallel
    results = []
    start_time = time.time()
    
    with ProcessPoolExecutor(max_workers=CONFIG['n_workers']) as executor:
        # Submit all tasks
        futures = [executor.submit(run_single_experiment, params) 
                  for params in all_params]
        
        # Process results as they complete
        for future in tqdm(as_completed(futures), total=len(futures)):
            try:
                result = future.result()
                results.append(result)
            except Exception as e:
                logger.error(f"Experiment failed: {e}")
    
    elapsed_time = time.time() - start_time
    logger.info(f"Completed {len(results)} experiments in {elapsed_time:.1f} seconds")
    
    # ===== STEP 4: SAVE RESULTS =====
    logger.info("\nStep 4: Saving results...")
    
    # Convert results to DataFrame
    results_df = pd.DataFrame(results)
    
    # Add metadata
    results_df['dgp_type'] = CONFIG['dgp_type']
    results_df['y_noise'] = CONFIG['y_noise']
    results_df['n_hist'] = CONFIG['n_hist']
    
    # Save to parquet
    output_file = output_dir / 'simulation_results.parquet'
    results_df.to_parquet(output_file, engine='pyarrow')
    logger.info(f"Results saved to: {output_file}")
    
    # ===== STEP 5: PRINT SUMMARY =====
    logger.info("\nStep 5: Summary Statistics")
    logger.info("-" * 40)
    
    # Group by sample size
    summary = results_df.groupby('n_trials').agg({
        'test_rmse': ['mean', 'std'],
        'ate_bias': ['mean', 'std'],
        'estimated_ate': ['mean', 'std']
    }).round(4)
    
    print("\nResults by Sample Size:")
    print(summary)
    
    # Save summary
    summary.to_csv(output_dir / 'summary_stats.csv')
    
    logger.info("\nSimulation complete!")


if __name__ == "__main__":
    main()
